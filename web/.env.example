# Copie para `web/.env.production` (e `web/.env.local` para testar com `npm run dev`) DEPOIS que o dono criar
# o projeto no Firebase (veja docs/SITE-COMO-PUBLICAR.md). Nunca versione o arquivo preenchido.
# Sem estas variáveis o site mostra "Site ainda não configurado".

# Console do Firebase > Configurações do projeto > Seus apps > App da Web > Configuração do SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_APP_ID=

# Opcionais. Sem a chave do reCAPTCHA v3 (App Check) a prévia por IA fica desligada e vale só o parser local.
VITE_RECAPTCHA_SITE_KEY=
VITE_AI_MODEL=gemini-3.5-flash-lite
