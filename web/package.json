{
  "name": "alerta-ibt-site",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulators": "firebase emulators:start --only auth,database --project demo-alertaibt",
    "build": "tsc -b && vite build",
    "test": "vitest run --project unit",
    "test:emu": "firebase emulators:exec --only auth,database --project demo-alertaibt \"vitest run --project emulator\"",
    "icons": "npm --prefix ../desktop/build run icons",
    "test:e2e": "firebase emulators:exec --only auth,database --project demo-alertaibt \"playwright test\"",
    "check:pwa": "node scripts/check-pwa.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "14.27.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
