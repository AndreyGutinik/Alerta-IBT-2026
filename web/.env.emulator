# Modo `vite --mode emulator`: tudo local, nada fala com a nuvem (projeto demo-*).
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-alertaibt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-alertaibt
VITE_FIREBASE_DATABASE_URL=https://demo-alertaibt-default-rtdb.firebaseio.com
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
