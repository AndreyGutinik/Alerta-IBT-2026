<UserControl
    x:Class="AlertaIBT.App.Views.SomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views"
    xmlns:theme="clr-namespace:AlertaIBT.App.Theme"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels">

    <!--
        The Som tab, top to bottom: (1) the player with its playlist and behaviour strip, (2) the alarms, (3) one bottom row with the start volumes and
        the audio outputs side by side (one column under about 1000 px of window). Cards, icon buttons and inputs come from the design system in
        Theme/SettingsStyles.xaml (Ibt* styles, CardSection, AdaptiveGrid); this page only lays them out.
    -->

    <UserControl.Resources>
        <!-- The device lists: they take the width of their column, so the right edge of every row lines up. -->
        <Style
            x:Key="OutputCombo"
            BasedOn="{StaticResource IbtComboBox}"
            TargetType="ComboBox">
            <Setter Property="DisplayMemberPath" Value="Display" />
        </Style>

        <!-- A 10 px status dot (the colour comes from the row: green active, yellow waiting, gray off). -->
        <Style x:Key="SomDot" BasedOn="{StaticResource IbtStatusDot}" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- "5 s | 3 s | seco". -->
        <DataTemplate x:Key="FadeButton" DataType="{x:Type vm:FadeOption}">
            <RadioButton
                AutomationProperties.Name="{Binding Label}"
                Content="{Binding Label}"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                Style="{StaticResource IbtSegItem}" />
        </DataTemplate>

        <DataTemplate x:Key="DayChipTemplate" DataType="{x:Type vm:DayChip}">
            <ToggleButton
                AutomationProperties.Name="{Binding Name}"
                Content="{Binding Letter}"
                IsChecked="{Binding IsOn, Mode=TwoWay}"
                Style="{StaticResource IbtDayDot}"
                ToolTip="{Binding Name}" />
        </DataTemplate>

        <!--
            One alarm is its own block: line one has the switch, the start (clock), the limit (alarm clock off) and the trash; line two the seven weekday
            dots and the playlist. Field names live in tooltips and automation names, not in the block.
        -->
        <DataTemplate x:Key="AlarmTemplate" DataType="{x:Type vm:AlarmRow}">
            <Border
                x:Name="Block"
                Style="{StaticResource IbtBlock}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Despertador ligado"
                            IsChecked="{Binding Enabled, Mode=TwoWay}"
                            Style="{StaticResource IbtSwitch}"
                            ToolTip="Liga e desliga só este despertador" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="20,0,0,0"
                            Background="Transparent"
                            Orientation="Horizontal"
                            ToolTip="Hora de início: a hora em que a música começa (hh:mm)">
                            <Path
                                Margin="0,0,8,0"
                                Data="{StaticResource LucideClock}"
                                Style="{StaticResource IbtRowIcon}" />
                            <TextBox
                                AutomationProperties.Name="Hora de início"
                                LostFocus="OnStartLostFocus"
                                Style="{StaticResource IbtNumberBox}"
                                Tag="{Binding}"
                                Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Hora de início: a hora em que a música começa (hh:mm)" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="16,0,0,0"
                            Background="Transparent"
                            Orientation="Horizontal"
                            ToolTip="Não iniciar depois de: se o PC abrir depois da hora de início, a música ainda começa até este horário. Depois dele, não começa.">
                            <Path
                                Margin="0,0,8,0"
                                Data="{StaticResource LucideAlarmClockOff}"
                                Style="{StaticResource IbtRowIcon}" />
                            <TextBox
                                AutomationProperties.Name="Não iniciar depois de"
                                LostFocus="OnLatestLostFocus"
                                Style="{StaticResource IbtNumberBox}"
                                Tag="{Binding}"
                                Text="{Binding LatestText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Não iniciar depois de: se o PC abrir depois da hora de início, a música ainda começa até este horário. Depois dele, não começa." />
                        </StackPanel>
                        <Button
                            Grid.Column="4"
                            AutomationProperties.Name="Remover despertador"
                            Command="{Binding RemoveCommand}"
                            Style="{StaticResource IbtDangerToolButton}"
                            ToolTip="Remover este despertador">
                            <Path
                                Width="16"
                                Height="16"
                                Data="{StaticResource LucideTrash2}"
                                Style="{StaticResource LucideIcon}" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ItemsControl
                            VerticalAlignment="Center"
                            Focusable="False"
                            ItemTemplate="{StaticResource DayChipTemplate}"
                            ItemsSource="{Binding Days}"
                            ToolTip="Dias da semana em que o despertador toca">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ComboBox
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Lista do despertador"
                            ItemsSource="{Binding PlaylistNames}"
                            SelectedItem="{Binding Playlist, Mode=TwoWay}"
                            Style="{StaticResource IbtComboBox}" />
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter TargetName="Block" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The dashed plus block at the end of the alarm grid. -->
        <DataTemplate x:Key="AddAlarmTemplate" DataType="{x:Type vm:AddAlarmTile}">
            <Button
                x:Name="AddAlarmButton"
                AutomationProperties.Name="Adicionar despertador"
                Command="{Binding AddCommand}"
                Style="{StaticResource IbtAddTile}"
                ToolTip="Adicionar despertador">
                <StackPanel Orientation="Horizontal">
                    <Path
                        Width="22"
                        Height="22"
                        Data="{StaticResource LucidePlus}"
                        Style="{StaticResource LucideIcon}" />
                    <TextBlock
                        x:Name="AddAlarmLabel"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="Adicionar despertador"
                        Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowLabel}" Value="True">
                    <Setter TargetName="AddAlarmLabel" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            One start volume: icon, short name, slider, the number with its percent sign, and one click-to-mute speaker. The long explanation is the
            tooltip of the row. The columns are fixed, so the four rows line up.
        -->
        <DataTemplate x:Key="VolumeRowTemplate" DataType="{x:Type vm:VolumeRow}">
            <Grid
                Height="32"
                Margin="0,0,0,12"
                Background="Transparent"
                ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" MinWidth="64" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Path
                    Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                    Style="{StaticResource IbtRowIcon}" />
                <TextBlock
                    Grid.Column="2"
                    Style="{StaticResource IbtRowLabel}"
                    Text="{Binding Label}" />
                <Slider
                    x:Name="VolumeSlider"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{Binding Label, StringFormat='Volume: {0}'}"
                    IsMoveToPointEnabled="True"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="0"
                    SmallChange="1"
                    Style="{StaticResource IbtSeekSlider}"
                    TickFrequency="1"
                    Value="{Binding Volume, Mode=TwoWay}" />
                <Grid Grid.Column="5">
                    <TextBox
                        AutomationProperties.Name="{Binding Label, StringFormat='Volume em porcentagem: {0}'}"
                        LostFocus="OnFieldLostFocus"
                        Padding="4,7,14,7"
                        Style="{StaticResource IbtNumberBox}"
                        Tag="{Binding Box}"
                        Text="{Binding Box.Text, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Volume de 0 a 100"
                        Width="52" />
                    <TextBlock
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource IbtMutedBrush}"
                        IsHitTestVisible="False"
                        Text="%" />
                </Grid>
                <ToggleButton
                    Grid.Column="7"
                    AutomationProperties.Name="Mudo"
                    IsChecked="{Binding Muted, Mode=TwoWay}"
                    Style="{StaticResource IbtMuteToggle}"
                    ToolTip="Mudo: clique para silenciar ou devolver o som" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="VolumeSlider" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Everything of the player card that needs the player on: dimmed and dead when it is off. -->
        <Style x:Key="HeroDim" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A round quiet button of the transport (previous, next, stop, mute). -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#991DA35F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shuffle and repeat: quiet, green wash when on. -->
        <Style x:Key="TransportToggle" TargetType="ToggleButton" BasedOn="{StaticResource IbtToggleChip}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Chip"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#261DA35F" />
                                <Setter Property="Foreground" Value="{StaticResource IbtOkBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="#331DA35F" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#991DA35F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepeatButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.Repeat}" Value="All">
                    <Setter Property="Background" Value="#261DA35F" />
                    <Setter Property="Foreground" Value="{StaticResource IbtOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Player.Repeat}" Value="One">
                    <Setter Property="Background" Value="#261DA35F" />
                    <Setter Property="Foreground" Value="{StaticResource IbtOkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The big round play and pause. -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Foreground" Value="#04130B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Disc"
                            Background="{StaticResource IbtAccentBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="28">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="16"
                                    Opacity="0.35"
                                    ShadowDepth="2"
                                    Color="#1DA35F" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#22B96C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource IbtCreamBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="42" />
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1280"
            Margin="24">
            <Grid Margin="0,0,0,24">
                <TextBlock Style="{StaticResource IbtPageTitle}" Text="Som" />
                <Border
                    x:Name="SavedBadge"
                    HorizontalAlignment="Right"
                    Style="{StaticResource IbtSavedBadge}">
                    <TextBlock FontSize="12" Text="{Binding Saver.Label}" />
                </Border>
            </Grid>

            <!-- ===== (1) The player, as wide as the page, with the playlist and the behaviour in a strip at its bottom ===== -->
            <Border
                x:Name="PlayerHero"
                Style="{StaticResource IbtSurfaceCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The album art: the cover, or a dark tile with a note when the track has none. -->
                    <Grid
                        x:Name="ArtHost"
                        Width="168"
                        Height="168"
                        VerticalAlignment="Center"
                        Style="{StaticResource HeroDim}">
                        <Border
                            Background="#15151A"
                            CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="24"
                                    Direction="270"
                                    Opacity="0.6"
                                    ShadowDepth="6" />
                            </Border.Effect>
                        </Border>
                        <Border
                            x:Name="CoverPlaceholder"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#24242B" />
                                    <GradientStop Offset="1" Color="#121216" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path
                                Width="54"
                                Height="54"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource LucideMusic}"
                                Style="{StaticResource LucideIcon}"
                                TextElement.Foreground="#6E695F" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player.HasCover}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border
                            x:Name="CoverImage"
                            CornerRadius="12"
                            Visibility="{Binding Player.HasCover, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Player.CoverArt}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="HeroInfo"
                        Grid.Column="2"
                        MinHeight="168">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The track: title, artist, and the playlist with the place in it. The switch and the next alarm sit in the top right corner. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                x:Name="HeroTrack"
                                Margin="0,0,16,0"
                                Style="{StaticResource HeroDim}">
                                <TextBlock
                                    x:Name="HeroTitleText"
                                    FontFamily="{StaticResource MarbleFont}"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource IbtCreamBrush}"
                                    Text="{Binding Player.HeroTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Player.HeroTitleTip}" />
                                <TextBlock
                                    x:Name="HeroArtistText"
                                    Margin="0,2,0,0"
                                    FontSize="13"
                                    Foreground="{StaticResource IbtMutedBrush}"
                                    Text="{Binding Player.HeroSubtitle}"
                                    TextTrimming="CharacterEllipsis" />
                                <Grid Margin="0,9,0,0">
                                    <Border
                                        x:Name="PlaylistChip"
                                        HorizontalAlignment="Left"
                                        Padding="9,3"
                                        Background="#14FFFFFF"
                                        BorderBrush="{StaticResource IbtLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Style="{StaticResource IbtChip}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Path
                                                Width="11"
                                                Height="11"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource LucideMusic}"
                                                Style="{StaticResource LucideIcon}"
                                                TextElement.Foreground="{StaticResource IbtMutedBrush}" />
                                            <TextBlock
                                                x:Name="PlaylistChipText"
                                                Grid.Column="1"
                                                FontSize="11.5"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{StaticResource IbtTextBrush}"
                                                Text="{Binding Player.PlaylistName}" />
                                            <TextBlock
                                                x:Name="TrackIndexLabel"
                                                Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{StaticResource IbtMutedBrush}"
                                                Text="{Binding Player.TrackIndexText}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <StackPanel
                                x:Name="HeroCorner"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        Text="Player ligado" />
                                    <ToggleButton
                                        x:Name="PlayerOnSwitch"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Player ligado"
                                        IsChecked="{Binding Player.PlayerOn, Mode=TwoWay}"
                                        Style="{StaticResource IbtSwitch}"
                                        ToolTip="Desligado: nada toca, os despertadores não disparam e a API (/player) e as teclas de mídia são ignoradas." />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- The timeline: elapsed on the left, the length on the right, the same width so nothing jumps. -->
                        <Grid
                            x:Name="SeekRow"
                            Grid.Row="1"
                            Margin="0,12"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeroDim}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ElapsedLabel"
                                Style="{StaticResource TimeLabel}"
                                Text="{Binding Player.ElapsedText}" />
                            <local:SeekSlider
                                x:Name="SeekSlider"
                                Grid.Column="1"
                                Margin="6,0"
                                AutomationProperties.Name="Linha do tempo"
                                IsEnabled="{Binding Player.CanSeek}"
                                Maximum="{Binding Player.SeekMaximum}"
                                Minimum="0"
                                Style="{StaticResource IbtSeekSlider}"
                                ToolTip="Clique ou arraste para ir a outro ponto da música. Setas esquerda e direita andam 5 s."
                                Value="{Binding Player.SeekValue, Mode=OneWay}" />
                            <TextBlock
                                x:Name="DurationLabel"
                                Grid.Column="2"
                                Style="{StaticResource TimeLabel}"
                                Text="{Binding Player.DurationText}"
                                TextAlignment="Right" />
                        </Grid>

                        <!-- The transport, centred under the timeline; stop on the left, the player volume on the right. -->
                        <Grid
                            x:Name="TransportRow"
                            Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                HorizontalAlignment="Left"
                                Style="{StaticResource HeroDim}">
                                <Button
                                    x:Name="StopButton"
                                    AutomationProperties.Name="Parar"
                                    Command="{Binding Player.StopCommand}"
                                    Style="{StaticResource TransportButton}"
                                    ToolTip="Parar (com fade)">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Data="{StaticResource LucideSquare}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                            </Border>
                            <StackPanel
                                x:Name="TransportCenter"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Style="{StaticResource HeroDim}">
                                <ToggleButton
                                    x:Name="ShuffleToggle"
                                    AutomationProperties.Name="Embaralhar"
                                    IsChecked="{Binding Player.Shuffle, Mode=TwoWay}"
                                    Style="{StaticResource TransportToggle}"
                                    ToolTip="Embaralhar: sorteia a próxima música, sem repetir até acabar a lista">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource LucideShuffle}"
                                        Style="{StaticResource LucideIcon}" />
                                </ToggleButton>
                                <Button
                                    x:Name="PreviousButton"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Anterior"
                                    Command="{Binding Player.PreviousCommand}"
                                    Style="{StaticResource TransportButton}"
                                    ToolTip="Anterior (volta ao começo se já passou de 3 s)">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource LucideSkipBack}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <Button
                                    x:Name="PlayPauseButton"
                                    Margin="8,0"
                                    AutomationProperties.Name="{Binding Player.PlayPauseTip}"
                                    Command="{Binding Player.PlayPauseCommand}"
                                    Style="{StaticResource PlayButton}"
                                    ToolTip="{Binding Player.PlayPauseTip}">
                                    <Path
                                        Width="22"
                                        Height="22"
                                        Data="{Binding Player.PlayPauseIconKey, Converter={StaticResource GeometryKey}}"
                                        Fill="#04130B"
                                        Style="{StaticResource LucideIcon}"
                                        StrokeThickness="2.2" />
                                </Button>
                                <Button
                                    x:Name="NextButton"
                                    Margin="0,0,6,0"
                                    AutomationProperties.Name="Próxima"
                                    Command="{Binding Player.NextCommand}"
                                    Style="{StaticResource TransportButton}"
                                    ToolTip="Próxima música">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource LucideSkipForward}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <Button
                                    x:Name="RepeatButton"
                                    AutomationProperties.Name="{Binding Player.RepeatText}"
                                    Command="{Binding Player.CycleRepeatCommand}"
                                    Style="{StaticResource RepeatButtonStyle}"
                                    ToolTip="{Binding Player.RepeatText}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{Binding Player.RepeatIconKey, Converter={StaticResource GeometryKey}}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                            </StackPanel>
                            <StackPanel
                                x:Name="PlayerVolumeBox"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Style="{StaticResource HeroDim}">
                                <Button
                                    x:Name="MuteButton"
                                    Width="30"
                                    Height="30"
                                    AutomationProperties.Name="Mudo"
                                    Command="{Binding Player.ToggleMuteCommand}"
                                    Style="{StaticResource TransportButton}"
                                    ToolTip="{Binding Player.MuteTip}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{Binding Player.VolumeIconKey, Converter={StaticResource GeometryKey}}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <Slider
                                    x:Name="PlayerVolumeSlider"
                                    Width="72"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Volume do player"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="100"
                                    Minimum="0"
                                    SmallChange="1"
                                    Style="{StaticResource IbtSeekSlider}"
                                    TickFrequency="1"
                                    ToolTip="Volume do player"
                                    Value="{Binding Player.Volume, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            x:Name="PlayerErrorText"
                            Grid.Row="3"
                            Style="{StaticResource IbtHint}"
                            Text="{Binding Player.LastError}"
                            Visibility="{Binding Player.HasError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    </Grid>

                    <!--
                        The strip: two halves. Left: the playlist (list, add, rename, delete; the folder with change and refresh). Right: how the player
                        behaves (fade when it stops, fade when an alarm starts, media keys), icons only, the name in the tooltip.
                    -->
                    <Border
                        x:Name="PlaylistStrip"
                        Grid.Row="1"
                        Margin="0,24,0,0"
                        Style="{StaticResource IbtBlock}">
                        <theme:AdaptiveGrid
                            x:Name="StripHalves"
                            Gap="24"
                            MaxColumns="2"
                            MinColumnWidth="380">
                            <StackPanel x:Name="PlaylistHalf">
                                <Grid Height="32">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        x:Name="PlaylistCombo"
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="Lista de músicas"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding Player.Playlists}"
                                        SelectedValue="{Binding Player.CurrentPlaylist, Mode=TwoWay}"
                                        SelectedValuePath="Name"
                                        Style="{StaticResource IbtComboBox}" />
                                    <Button
                                        x:Name="AddPlaylistButton"
                                        Grid.Column="1"
                                        AutomationProperties.Name="Adicionar lista"
                                        Command="{Binding AddPlaylistCommand}"
                                        Style="{StaticResource IbtToolButton}"
                                        ToolTip="Adicionar lista: escolha a pasta da música, a lista leva o nome da pasta">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource LucidePlus}"
                                            Style="{StaticResource LucideIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="RenamePlaylistButton"
                                        Grid.Column="2"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Renomear lista"
                                        Command="{Binding RenamePlaylistCommand}"
                                        IsEnabled="{Binding HasPlaylist}"
                                        Style="{StaticResource IbtToolButton}"
                                        ToolTip="Renomear esta lista">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource LucidePencil}"
                                            Style="{StaticResource LucideIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="RemovePlaylistButton"
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Excluir lista"
                                        Command="{Binding RemovePlaylistCommand}"
                                        IsEnabled="{Binding HasPlaylist}"
                                        Style="{StaticResource IbtDangerToolButton}"
                                        ToolTip="Excluir esta lista (as músicas ficam na pasta)">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource LucideTrash2}"
                                            Style="{StaticResource LucideIcon}" />
                                    </Button>
                                </Grid>
                                <Grid
                                    Height="32"
                                    Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource LucideFolder}"
                                        Style="{StaticResource LucideIcon}"
                                        TextElement.Foreground="{StaticResource IbtMutedBrush}" />
                                    <TextBlock
                                        x:Name="PlaylistInfoText"
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource IbtTextSecondaryBrush}"
                                        Text="{Binding PlaylistFolder}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding PlaylistInfo}" />
                                    <Button
                                        x:Name="ChangeFolderButton"
                                        Grid.Column="2"
                                        AutomationProperties.Name="Trocar a pasta"
                                        Command="{Binding ChangeFolderCommand}"
                                        IsEnabled="{Binding HasPlaylist}"
                                        Style="{StaticResource IbtToolButton}"
                                        ToolTip="Trocar a pasta: escolher outra pasta para esta lista">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource LucideFolder}"
                                            Style="{StaticResource LucideIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="RefreshButton"
                                        Grid.Column="3"
                                        Margin="4,0,0,0"
                                        AutomationProperties.Name="Atualizar"
                                        Command="{Binding Player.RefreshCommand}"
                                        Style="{StaticResource IbtToolButton}"
                                        ToolTip="Atualizar: ler a pasta de novo e conferir as saídas">
                                        <Path
                                            Width="16"
                                            Height="16"
                                            Data="{StaticResource LucideRefreshCw}"
                                            Style="{StaticResource LucideIcon}" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Three aligned icon rows in one line (fade out, fade in, media keys): the half is at least 380 px wide, so they never wrap; narrower than that the strip stacks. -->
                            <WrapPanel
                                x:Name="BehaviorHalf"
                                HorizontalAlignment="Left"
                                Margin="0,0,-10,-8">
                                <StackPanel
                                    x:Name="StopFadeRow"
                                    Margin="0,0,10,8"
                                    Background="Transparent"
                                    Orientation="Horizontal"
                                    ToolTip="Fade ao parar: quanto dura a descida do volume ao pausar ou parar (pelo botão, pela API do Holyrics ou pelas teclas). Seco para na hora, sem estalo.">
                                    <Path
                                        Margin="0,0,8,0"
                                        Data="{StaticResource IbtFadeOut}"
                                        Style="{StaticResource IbtRowIcon}" />
                                    <Border Style="{StaticResource IbtSegmentedFrame}">
                                        <ItemsControl
                                            x:Name="StopFadeList"
                                            AutomationProperties.Name="Fade ao parar"
                                            Focusable="False"
                                            ItemTemplate="{StaticResource FadeButton}"
                                            ItemsSource="{Binding StopFadeOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                                <StackPanel
                                    x:Name="AlarmFadeRow"
                                    Margin="0,0,10,8"
                                    Background="Transparent"
                                    Orientation="Horizontal"
                                    ToolTip="Fade ao começar pelo despertador: quanto dura a subida do volume quando um despertador começa a música. Seco começa direto no volume.">
                                    <Path
                                        Margin="0,0,8,0"
                                        Data="{StaticResource IbtFadeIn}"
                                        Style="{StaticResource IbtRowIcon}" />
                                    <Border Style="{StaticResource IbtSegmentedFrame}">
                                        <ItemsControl
                                            x:Name="AlarmFadeList"
                                            AutomationProperties.Name="Fade ao começar pelo despertador"
                                            Focusable="False"
                                            ItemTemplate="{StaticResource FadeButton}"
                                            ItemsSource="{Binding AlarmFadeOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                                <StackPanel
                                    x:Name="MediaKeysRow"
                                    Margin="0,0,10,8"
                                    Background="Transparent"
                                    Orientation="Horizontal"
                                    ToolTip="Teclas de mídia: as teclas de play/pausa, próxima, anterior e parar do teclado comandam o player. O app só ouve essas teclas; as outras (e o que é digitado) ele não guarda.">
                                    <Path
                                        Margin="0,0,8,0"
                                        Data="{StaticResource LucideKeyboard}"
                                        Style="{StaticResource IbtRowIcon}" />
                                    <ToggleButton
                                        x:Name="MediaKeysSwitch"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Teclas de mídia controlam o player"
                                        IsChecked="{Binding Player.MediaKeys, Mode=TwoWay}"
                                        Style="{StaticResource IbtSwitch}"
                                        ToolTip="Teclas de mídia: ligado, as teclas de play/pausa, próxima, anterior e parar do teclado comandam o player" />
                                </StackPanel>
                            </WrapPanel>
                        </theme:AdaptiveGrid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== (2) The alarms: a header with the master and the next one, each alarm its own block, two per row ===== -->
            <local:CardSection
                x:Name="AlarmsSection"
                Margin="0,24,0,0"
                Header="Despertadores"
                Icon="{StaticResource LucideAlarmClock}"
                Info="Cada despertador começa a música sozinho, na hora, nos dias marcados. Se o PC abrir depois da hora mas antes do limite, a música começa na hora que ele abrir. Nunca para a música que já está tocando."
                Style="{StaticResource IbtCardSectionStyle}">
                <local:CardSection.HeaderActions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            x:Name="AlarmsNextText"
                            MaxWidth="260"
                            Margin="0,0,12,0"
                            Style="{StaticResource IbtSecondaryText}"
                            Text="{Binding NextAlarmShort}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Player.NextAlarmText}" />
                        <ToggleButton
                            x:Name="AlarmsOnSwitch"
                            AutomationProperties.Name="Despertadores ligados"
                            IsChecked="{Binding Player.AlarmsEnabled, Mode=TwoWay}"
                            Style="{StaticResource IbtPowerToggle}"
                            ToolTip="Despertadores ligados: desligado, nenhum despertador toca" />
                    </StackPanel>
                </local:CardSection.HeaderActions>
                <ItemsControl
                    x:Name="AlarmList"
                    Focusable="False"
                    ItemsSource="{Binding AlarmTiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <theme:AdaptiveGrid
                                Gap="16"
                                MaxColumns="2"
                                MinColumnWidth="360" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:AlarmRow}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AlarmTemplate}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AddAlarmTile}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AddAlarmTemplate}" />
                        </DataTemplate>
                    </ItemsControl.Resources>
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Player.AlarmsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </local:CardSection>

            <!-- ===== (3) The bottom row: the volumes at start and the audio outputs, side by side (stacked when narrow) ===== -->
            <theme:AdaptiveGrid
                x:Name="BottomRow"
                Margin="0,24,0,0"
                Gap="24"
                MaxColumns="2"
                MinColumnWidth="340">
                <local:CardSection
                    x:Name="VolumesSection"
                    Header="Volumes ao iniciar"
                    Icon="{StaticResource LucideVolume2}"
                    Info="Os volumes que o app põe quando o PC liga e quando um programa abre o som. Desligado, o app não mexe em nenhum volume (só em Aplicar agora)."
                    Style="{StaticResource IbtCardSectionStyle}">
                    <local:CardSection.HeaderActions>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                x:Name="AdjustDot"
                                Margin="0,0,4,0"
                                AutomationProperties.Name="Estado do ajuste"
                                Style="{StaticResource IbtDotHost}"
                                ToolTip="{Binding AdjustStatusTip}">
                                <Ellipse
                                    Fill="{Binding AdjustLight, Converter={StaticResource StatusLightBrush}}"
                                    Style="{StaticResource SomDot}" />
                            </Border>
                            <Button
                                x:Name="ApplyNowButton"
                                AutomationProperties.Name="Aplicar agora"
                                Command="{Binding ApplyNowCommand}"
                                Style="{StaticResource IbtToolButton}"
                                ToolTip="{Binding ApplyTip}">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideZap}"
                                    Style="{StaticResource LucideIcon}" />
                            </Button>
                            <ToggleButton
                                x:Name="AdjustSwitch"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Ajustar o som ao iniciar"
                                IsChecked="{Binding AdjustAtStart, Mode=TwoWay}"
                                Style="{StaticResource IbtPowerToggle}"
                                ToolTip="{Binding AdjustSwitchTip}" />
                        </StackPanel>
                    </local:CardSection.HeaderActions>
                    <ItemsControl
                        x:Name="VolumeList"
                        Margin="0,0,0,-12"
                        Focusable="False"
                        ItemTemplate="{StaticResource VolumeRowTemplate}"
                        ItemsSource="{Binding VolumeRows}" />
                </local:CardSection>

                <local:CardSection
                    x:Name="OutputsSection"
                    Header="Saídas de áudio"
                    Icon="{StaticResource LucideSpeaker}"
                    Info="Por onde o som sai na mesa: o padrão do Windows, o player e o Holyrics. O ponto mostra o estado: verde, saída ativa; amarelo, esperando o aparelho (a WING desligada, por exemplo); cinza, desligado. Passe o mouse no ponto para ler o detalhe."
                    Style="{StaticResource IbtCardSectionStyle}">
                    <Grid x:Name="OutputGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>

                        <Path
                            Data="{StaticResource LucideMonitorSpeaker}"
                            Style="{StaticResource IbtRowIcon}" />
                        <TextBlock
                            Grid.Column="2"
                            Style="{StaticResource IbtRowLabel}"
                            Text="Windows"
                            ToolTip="Saída padrão do Windows: a saída de som que o Windows usa para tudo que não tem saída própria. Se o aparelho escolhido não estiver ligado, o app espera e não mexe em nada." />
                        <ComboBox
                            x:Name="DefaultOutputCombo"
                            Grid.Column="3"
                            AutomationProperties.Name="Saída padrão do Windows"
                            ItemsSource="{Binding DefaultOutput.Choices}"
                            SelectedItem="{Binding DefaultOutput.Selected, Mode=TwoWay}"
                            Style="{StaticResource OutputCombo}" />
                        <Border
                            x:Name="DefaultOutputDot"
                            Grid.Column="4"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="Estado da saída padrão"
                            Style="{StaticResource IbtDotHost}"
                            ToolTip="{Binding DefaultOutput.Status}">
                            <Ellipse
                                Fill="{Binding DefaultOutput.Light, Converter={StaticResource StatusLightBrush}}"
                                Style="{StaticResource SomDot}" />
                        </Border>
                        <ToggleButton
                            x:Name="LockSwitch"
                            Grid.Column="5"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Travar a saída padrão neste dispositivo"
                            IsChecked="{Binding LockOutput, Mode=TwoWay}"
                            Style="{StaticResource IbtLockToggle}"
                            ToolTip="Travar a saída padrão neste dispositivo: se o Windows trocar a saída padrão (por exemplo quando um aparelho USB liga), o app põe de volta neste dispositivo. É o único lugar onde isto se liga e desliga." />

                        <Path
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource LucideMusic}"
                            Style="{StaticResource IbtRowIcon}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,12,0,0"
                            Style="{StaticResource IbtRowLabel}"
                            Text="Player"
                            ToolTip="Saída do player: por onde sai a música do player (a saída 3-4 da mesa). Se o aparelho não estiver ligado, toca na saída padrão do Windows." />
                        <ComboBox
                            x:Name="PlayerOutputCombo"
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="0,12,0,0"
                            AutomationProperties.Name="Saída do player"
                            ItemsSource="{Binding PlayerOutput.Choices}"
                            SelectedItem="{Binding PlayerOutput.Selected, Mode=TwoWay}"
                            Style="{StaticResource OutputCombo}" />
                        <Border
                            x:Name="PlayerOutputDot"
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="4,12,0,0"
                            AutomationProperties.Name="Estado da saída do player"
                            Style="{StaticResource IbtDotHost}"
                            ToolTip="{Binding PlayerOutput.Status}">
                            <Ellipse
                                Fill="{Binding PlayerOutput.Light, Converter={StaticResource StatusLightBrush}}"
                                Style="{StaticResource SomDot}" />
                        </Border>

                        <Path
                            Grid.Row="2"
                            Margin="0,12,0,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource LucidePresentation}"
                            Style="{StaticResource IbtRowIcon}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,12,0,0"
                            Style="{StaticResource IbtRowLabel}"
                            Text="Holyrics"
                            ToolTip="Saída do Holyrics: por onde sai o som do Holyrics (a saída 1-2 da mesa). É a saída por programa do Windows, a mesma de Configurações, Sistema, Som, Misturador de volume. Se o aparelho não estiver ligado, o Holyrics fica como está." />
                        <ComboBox
                            x:Name="HolyricsOutputCombo"
                            Grid.Row="2"
                            Grid.Column="3"
                            Margin="0,12,0,0"
                            AutomationProperties.Name="Saída do Holyrics"
                            ItemsSource="{Binding HolyricsOutput.Choices}"
                            SelectedItem="{Binding HolyricsOutput.Selected, Mode=TwoWay}"
                            Style="{StaticResource OutputCombo}" />
                        <Border
                            x:Name="HolyricsOutputDot"
                            Grid.Row="2"
                            Grid.Column="4"
                            Margin="4,12,0,0"
                            AutomationProperties.Name="Estado da saída do Holyrics"
                            Style="{StaticResource IbtDotHost}"
                            ToolTip="{Binding HolyricsOutput.Status}">
                            <Ellipse
                                Fill="{Binding HolyricsOutput.Light, Converter={StaticResource StatusLightBrush}}"
                                Style="{StaticResource SomDot}" />
                        </Border>
                        <ToggleButton
                            x:Name="HolyricsRouteSwitch"
                            Grid.Row="2"
                            Grid.Column="5"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Definir a saída do Holyrics"
                            IsChecked="{Binding HolyricsRoute, Mode=TwoWay}"
                            Style="{StaticResource IbtPinToggle}"
                            ToolTip="Definir a saída do Holyrics: ligado, quando o Holyrics começa a tocar o app põe a saída dele na escolhida ao lado. Desligado, o app nunca mexe na saída do Holyrics." />
                    </Grid>
                </local:CardSection>
            </theme:AdaptiveGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
