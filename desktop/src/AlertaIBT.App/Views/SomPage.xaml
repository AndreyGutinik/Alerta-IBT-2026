<UserControl
    x:Class="AlertaIBT.App.Views.SomPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels">

    <UserControl.Resources>
        <!-- A line of status under a row: quiet, small, wraps. -->
        <Style x:Key="SomStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <!-- The small caption over a field (alarm rows). -->
        <Style x:Key="SomCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- The device lists: all the same width, so the right edge of every card lines up. -->
        <Style
            x:Key="OutputCombo"
            BasedOn="{StaticResource IbtComboBox}"
            TargetType="ComboBox">
            <Setter Property="Width" Value="210" />
            <Setter Property="DisplayMemberPath" Value="Display" />
        </Style>

        <!-- The number box and "Com som | Mudo" of a volume row. -->
        <DataTemplate x:Key="VolumeBox" DataType="{x:Type vm:VolumeRow}">
            <StackPanel Orientation="Horizontal">
                <TextBox
                    Width="46"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Volume em porcentagem"
                    LostFocus="OnFieldLostFocus"
                    Style="{StaticResource IbtSmallInput}"
                    Tag="{Binding Box}"
                    ToolTip="Volume de 0 a 100"
                    Text="{Binding Box.Text, UpdateSourceTrigger=PropertyChanged}" />
                <Border
                    BorderBrush="{StaticResource IbtLineBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            AutomationProperties.Name="Com som"
                            Content="Com som"
                            IsChecked="{Binding WithSound, Mode=TwoWay}"
                            Style="{StaticResource IbtSegButton}">
                            <RadioButton.Padding>9,6</RadioButton.Padding>
                        </RadioButton>
                        <RadioButton
                            AutomationProperties.Name="Mudo"
                            Content="Mudo"
                            IsChecked="{Binding IsMuted, Mode=TwoWay}"
                            Style="{StaticResource IbtSegButton}">
                            <RadioButton.Padding>9,6</RadioButton.Padding>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="VolumeSlider" DataType="{x:Type vm:VolumeRow}">
            <Slider
                Margin="0,8,0,0"
                AutomationProperties.Name="Volume"
                IsMoveToPointEnabled="True"
                IsSnapToTickEnabled="True"
                LargeChange="10"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                Style="{StaticResource IbtSeekSlider}"
                TickFrequency="1"
                Value="{Binding Volume, Mode=TwoWay}" />
        </DataTemplate>

        <!-- "5 s | 3 s | seco". -->
        <DataTemplate x:Key="FadeButton" DataType="{x:Type vm:FadeOption}">
            <RadioButton
                AutomationProperties.Name="{Binding Label}"
                Content="{Binding Label}"
                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                Style="{StaticResource IbtSegButton}">
                <RadioButton.Padding>12,6</RadioButton.Padding>
            </RadioButton>
        </DataTemplate>

        <DataTemplate x:Key="DayChipTemplate" DataType="{x:Type vm:DayChip}">
            <ToggleButton
                AutomationProperties.Name="{Binding Name}"
                Content="{Binding Letter}"
                IsChecked="{Binding IsOn, Mode=TwoWay}"
                Style="{StaticResource IbtToggleChip}"
                ToolTip="{Binding Name}" />
        </DataTemplate>

        <!--
            One alarm, two lines that always line up: the switch, the start, "não iniciar depois de" and the trash; under them the weekdays and
            the playlist (the playlist drops under the weekdays when the card is narrow).
        -->
        <DataTemplate x:Key="AlarmTemplate" DataType="{x:Type vm:AlarmRow}">
            <Border
                Padding="0,12"
                BorderBrush="{StaticResource IbtLineBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton
                            Margin="0,0,16,5"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Despertador ligado"
                            IsChecked="{Binding Enabled, Mode=TwoWay}"
                            Style="{StaticResource IbtSwitch}"
                            ToolTip="Liga e desliga só este despertador" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SomCaption}" Text="Início" />
                            <TextBox
                                Width="58"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Hora de início"
                                LostFocus="OnStartLostFocus"
                                Style="{StaticResource IbtSmallInput}"
                                Tag="{Binding}"
                                Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="A hora em que a música começa (hh:mm)" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource SomCaption}" Text="Não iniciar depois de" />
                            <TextBox
                                Width="58"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Não iniciar depois de"
                                LostFocus="OnLatestLostFocus"
                                Style="{StaticResource IbtSmallInput}"
                                Tag="{Binding}"
                                Text="{Binding LatestText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Se o PC abrir depois da hora de início, a música ainda começa até este horário. Depois dele, não começa." />
                        </StackPanel>
                        <Button
                            Grid.Column="4"
                            VerticalAlignment="Bottom"
                            AutomationProperties.Name="Remover despertador"
                            Command="{Binding RemoveCommand}"
                            Style="{StaticResource IbtIconButton}"
                            ToolTip="Remover este despertador">
                            <Path
                                Width="14"
                                Height="14"
                                Data="{StaticResource LucideTrash2}"
                                Style="{StaticResource LucideIcon}" />
                        </Button>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource SomCaption}" Text="Dias" />
                            <ItemsControl
                                Focusable="False"
                                ItemTemplate="{StaticResource DayChipTemplate}"
                                ItemsSource="{Binding Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SomCaption}" Text="Lista" />
                            <ComboBox
                                Width="130"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Lista do despertador"
                                ItemsSource="{Binding PlaylistNames}"
                                SelectedItem="{Binding Playlist, Mode=TwoWay}"
                                Style="{StaticResource IbtComboBox}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===== The player card ===== -->

        <Style x:Key="HeroCard" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#16FFFFFF" />
                        <GradientStop Offset="1" Color="#07FFFFFF" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Everything of the player card that needs the player on: dimmed and dead when it is off. -->
        <Style x:Key="HeroDim" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.IsEnabled}" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A round quiet button of the transport (previous, next, stop, mute). -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#991DA35F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shuffle and repeat: quiet, green wash when on. -->
        <Style x:Key="TransportToggle" TargetType="ToggleButton" BasedOn="{StaticResource IbtToggleChip}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Chip"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#261DA35F" />
                                <Setter Property="Foreground" Value="{StaticResource IbtOkBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Chip" Property="Background" Value="#331DA35F" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="#991DA35F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RepeatButtonStyle" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Player.Repeat}" Value="All">
                    <Setter Property="Background" Value="#261DA35F" />
                    <Setter Property="Foreground" Value="{StaticResource IbtOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Player.Repeat}" Value="One">
                    <Setter Property="Background" Value="#261DA35F" />
                    <Setter Property="Foreground" Value="{StaticResource IbtOkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The big round play and pause. -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Foreground" Value="#04130B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Disc"
                            Background="{StaticResource IbtAccentBrush}"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="28">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="16"
                                    Opacity="0.35"
                                    ShadowDepth="2"
                                    Color="#1DA35F" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#22B96C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource IbtCreamBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="42" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Grid Margin="0,0,0,12">
                <TextBlock Style="{StaticResource IbtTitle}" Text="Som" />
                <Border
                    x:Name="SavedBadge"
                    HorizontalAlignment="Right"
                    Style="{StaticResource IbtSavedBadge}">
                    <TextBlock FontSize="12" Text="{Binding Saver.Label}" />
                </Border>
            </Grid>

            <!-- ===== The player, on top, as wide as the page ===== -->
            <Border
                x:Name="PlayerHero"
                Style="{StaticResource HeroCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- The album art: the cover, or a dark tile with a note when the track has none. -->
                    <Grid
                        x:Name="ArtHost"
                        Width="168"
                        Height="168"
                        VerticalAlignment="Center"
                        Style="{StaticResource HeroDim}">
                        <Border
                            Background="#15151A"
                            CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="24"
                                    Direction="270"
                                    Opacity="0.6"
                                    ShadowDepth="6" />
                            </Border.Effect>
                        </Border>
                        <Border
                            x:Name="CoverPlaceholder"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#24242B" />
                                    <GradientStop Offset="1" Color="#121216" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path
                                Width="54"
                                Height="54"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="{StaticResource LucideMusic}"
                                Style="{StaticResource LucideIcon}"
                                TextElement.Foreground="#6E695F" />
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Player.HasCover}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border
                            x:Name="CoverImage"
                            CornerRadius="12"
                            Visibility="{Binding Player.HasCover, Converter={StaticResource BoolToVisibility}}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Player.CoverArt}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="HeroInfo"
                        Grid.Column="2"
                        MinHeight="168">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- The track: title, artist, and the playlist with the place in it. The switch and the next alarm sit in the top right corner. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                x:Name="HeroTrack"
                                Margin="0,0,16,0"
                                Style="{StaticResource HeroDim}">
                                <TextBlock
                                    x:Name="HeroTitleText"
                                    FontFamily="{StaticResource MarbleFont}"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource IbtCreamBrush}"
                                    Text="{Binding Player.HeroTitle}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Player.HeroTitleTip}" />
                                <TextBlock
                                    x:Name="HeroArtistText"
                                    Margin="0,2,0,0"
                                    FontSize="13"
                                    Foreground="{StaticResource IbtMutedBrush}"
                                    Text="{Binding Player.HeroSubtitle}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel
                                    Margin="0,9,0,0"
                                    Orientation="Horizontal">
                                    <Border
                                        x:Name="PlaylistChip"
                                        Padding="9,3"
                                        Background="#14FFFFFF"
                                        BorderBrush="{StaticResource IbtLineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Style="{StaticResource IbtChip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="11"
                                                Height="11"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Data="{StaticResource LucideMusic}"
                                                Style="{StaticResource LucideIcon}"
                                                TextElement.Foreground="{StaticResource IbtMutedBrush}" />
                                            <TextBlock
                                                x:Name="PlaylistChipText"
                                                FontSize="11.5"
                                                Foreground="{StaticResource IbtTextBrush}"
                                                Text="{Binding Player.PlaylistName}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        x:Name="TrackIndexLabel"
                                        Margin="9,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource IbtMutedBrush}"
                                        Text="{Binding Player.TrackIndexText}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                x:Name="HeroCorner"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="12.5"
                                        Text="Player ligado" />
                                    <ToggleButton
                                        x:Name="PlayerOnSwitch"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Player ligado"
                                        IsChecked="{Binding Player.PlayerOn, Mode=TwoWay}"
                                        Style="{StaticResource IbtSwitch}"
                                        ToolTip="Desligado: nada toca, os despertadores não disparam e a API (/player) e as teclas de mídia são ignoradas." />
                                </StackPanel>
                                <TextBlock
                                    x:Name="NextAlarmText"
                                    MaxWidth="200"
                                    Margin="0,7,0,0"
                                    HorizontalAlignment="Right"
                                    FontSize="11.5"
                                    Foreground="{StaticResource IbtMutedBrush}"
                                    Text="{Binding Player.NextAlarmText}"
                                    TextAlignment="Right"
                                    TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Player.IsEnabled}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!-- The timeline: elapsed on the left, the length on the right, the same width so nothing jumps. -->
                        <Grid
                            x:Name="SeekRow"
                            Grid.Row="1"
                            Margin="0,10"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeroDim}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="ElapsedLabel"
                                Style="{StaticResource TimeLabel}"
                                Text="{Binding Player.ElapsedText}" />
                            <local:SeekSlider
                                x:Name="SeekSlider"
                                Grid.Column="1"
                                Margin="6,0"
                                AutomationProperties.Name="Linha do tempo"
                                IsEnabled="{Binding Player.CanSeek}"
                                Maximum="{Binding Player.SeekMaximum}"
                                Minimum="0"
                                Style="{StaticResource IbtSeekSlider}"
                                ToolTip="Clique ou arraste para ir a outro ponto da música. Setas esquerda e direita andam 5 s."
                                Value="{Binding Player.SeekValue, Mode=OneWay}" />
                            <TextBlock
                                x:Name="DurationLabel"
                                Grid.Column="2"
                                Style="{StaticResource TimeLabel}"
                                Text="{Binding Player.DurationText}"
                                TextAlignment="Right" />
                        </Grid>

                        <!-- The transport, centred under the timeline; stop on the left, the player volume on the right. -->
                        <Grid
                            x:Name="TransportRow"
                            Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="StopButton"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Parar"
                                Command="{Binding Player.StopCommand}"
                                Style="{StaticResource TransportButton}"
                                ToolTip="Parar (com fade)">
                                <Path
                                    Width="14"
                                    Height="14"
                                    Data="{StaticResource LucideSquare}"
                                    Style="{StaticResource LucideIcon}" />
                            </Button>
                            <StackPanel
                                x:Name="TransportCenter"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Style="{StaticResource HeroDim}">
                                <ToggleButton
                                    x:Name="ShuffleToggle"
                                    AutomationProperties.Name="Embaralhar"
                                    IsChecked="{Binding Player.Shuffle, Mode=TwoWay}"
                                    Style="{StaticResource TransportToggle}"
                                    ToolTip="Embaralhar: sorteia a próxima música, sem repetir até acabar a lista">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource LucideShuffle}"
                                        Style="{StaticResource LucideIcon}" />
                                </ToggleButton>
                                <Button
                                    x:Name="PreviousButton"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Anterior"
                                    Command="{Binding Player.PreviousCommand}"
                                    Style="{StaticResource TransportButton}"
                                    ToolTip="Anterior (volta ao começo se já passou de 3 s)">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource LucideSkipBack}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <Button
                                    x:Name="PlayPauseButton"
                                    Margin="8,0"
                                    AutomationProperties.Name="{Binding Player.PlayPauseTip}"
                                    Command="{Binding Player.PlayPauseCommand}"
                                    Style="{StaticResource PlayButton}"
                                    ToolTip="{Binding Player.PlayPauseTip}">
                                    <Path
                                        Width="22"
                                        Height="22"
                                        Data="{Binding Player.PlayPauseIconKey, Converter={StaticResource GeometryKey}}"
                                        Fill="#04130B"
                                        Style="{StaticResource LucideIcon}"
                                        StrokeThickness="2.2" />
                                </Button>
                                <Button
                                    x:Name="NextButton"
                                    Margin="0,0,6,0"
                                    AutomationProperties.Name="Próxima"
                                    Command="{Binding Player.NextCommand}"
                                    Style="{StaticResource TransportButton}"
                                    ToolTip="Próxima música">
                                    <Path
                                        Width="18"
                                        Height="18"
                                        Data="{StaticResource LucideSkipForward}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <Button
                                    x:Name="RepeatButton"
                                    AutomationProperties.Name="{Binding Player.RepeatText}"
                                    Command="{Binding Player.CycleRepeatCommand}"
                                    Style="{StaticResource RepeatButtonStyle}"
                                    ToolTip="{Binding Player.RepeatText}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{Binding Player.RepeatIconKey, Converter={StaticResource GeometryKey}}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                            </StackPanel>
                            <StackPanel
                                x:Name="PlayerVolumeBox"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Style="{StaticResource HeroDim}">
                                <Button
                                    x:Name="MuteButton"
                                    Width="30"
                                    Height="30"
                                    AutomationProperties.Name="Mudo"
                                    Command="{Binding Player.ToggleMuteCommand}"
                                    Style="{StaticResource TransportButton}"
                                    ToolTip="{Binding Player.MuteTip}">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{Binding Player.VolumeIconKey, Converter={StaticResource GeometryKey}}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <Slider
                                    x:Name="PlayerVolumeSlider"
                                    Width="72"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Volume do player"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="100"
                                    Minimum="0"
                                    SmallChange="1"
                                    Style="{StaticResource IbtSeekSlider}"
                                    TickFrequency="1"
                                    ToolTip="Volume do player"
                                    Value="{Binding Player.Volume, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            x:Name="PlayerErrorText"
                            Grid.Row="3"
                            Style="{StaticResource IbtHint}"
                            Text="{Binding Player.LastError}"
                            Visibility="{Binding Player.HasError, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== The settings, two columns of cards ===== -->
            <Grid x:Name="SettingsGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left: the volumes and where the sound goes. (Under about 800 px the two columns become one: left first, then right.) -->
                <StackPanel x:Name="LeftColumn">
                    <local:SettingsSection
                        x:Name="VolumesSection"
                        Header="Volumes ao iniciar"
                        Style="{StaticResource SettingsSectionStyle}"
                        Subtitle="Os volumes que o app põe quando o PC liga e quando um programa abre o som.">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="AdjustRow"
                                Title="Ajustar o som ao iniciar"
                                Info="Quando o PC liga e a cada vez que um programa abre o som dele, o app põe o volume que está nesta lista.&#10;Desligado, o app não mexe em nenhum volume (só em Aplicar agora)."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="AdjustSwitch"
                                    AutomationProperties.Name="Ajustar o som ao iniciar"
                                    IsChecked="{Binding AdjustAtStart, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="MasterRowView"
                                Title="Volume geral do Windows"
                                Info="O volume principal da saída do Windows (o controle do alto-falante na barra de tarefas)."
                                Style="{StaticResource SettingRowStyle}">
                                <ContentControl
                                    Content="{Binding MasterRow}"
                                    ContentTemplate="{StaticResource VolumeBox}"
                                    Focusable="False" />
                                <local:SettingRow.Footer>
                                    <ContentControl
                                        Content="{Binding MasterRow}"
                                        ContentTemplate="{StaticResource VolumeSlider}"
                                        Focusable="False" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="HolyricsVolumeRow"
                                Title="Holyrics"
                                Info="O volume do Holyrics (o som dele vem do javaw). Vale a cada vez que o Holyrics abre."
                                Style="{StaticResource SettingRowStyle}">
                                <ContentControl
                                    Content="{Binding HolyricsRow}"
                                    ContentTemplate="{StaticResource VolumeBox}"
                                    Focusable="False" />
                                <local:SettingRow.Footer>
                                    <ContentControl
                                        Content="{Binding HolyricsRow}"
                                        ContentTemplate="{StaticResource VolumeSlider}"
                                        Focusable="False" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="PlayerVolumeRow"
                                Title="Player"
                                Info="O volume do player de música do app. Mudo deixa o player calado. É o mesmo controle do volume ao lado do play."
                                Style="{StaticResource SettingRowStyle}">
                                <ContentControl
                                    Content="{Binding PlayerRow}"
                                    ContentTemplate="{StaticResource VolumeBox}"
                                    Focusable="False" />
                                <local:SettingRow.Footer>
                                    <ContentControl
                                        Content="{Binding PlayerRow}"
                                        ContentTemplate="{StaticResource VolumeSlider}"
                                        Focusable="False" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="SystemSoundsRowView"
                                Title="Sons do Windows (notificações e afins)"
                                Info="Os avisos sonoros do Windows (o item Sons do sistema do misturador de volume). Em 0, eles não tocam no telão."
                                Style="{StaticResource SettingRowStyle}">
                                <ContentControl
                                    Content="{Binding SystemSoundsRow}"
                                    ContentTemplate="{StaticResource VolumeBox}"
                                    Focusable="False" />
                                <local:SettingRow.Footer>
                                    <ContentControl
                                        Content="{Binding SystemSoundsRow}"
                                        ContentTemplate="{StaticResource VolumeSlider}"
                                        Focusable="False" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="ApplyRowView"
                                Title="Aplicar agora"
                                Info="Põe todos os volumes da lista agora, nos programas que já estão tocando, e a saída do Holyrics."
                                Style="{StaticResource SettingRowStyle}">
                                <Button
                                    x:Name="ApplyNowButton"
                                    AutomationProperties.Name="Aplicar agora"
                                    Command="{Binding ApplyNowCommand}"
                                    Style="{StaticResource IbtButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="15"
                                            Height="15"
                                            Data="{StaticResource LucideVolume2}"
                                            Style="{StaticResource LucideIcon}" />
                                        <TextBlock Margin="6,0,0,0" Text="Aplicar agora" />
                                    </StackPanel>
                                </Button>
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="AppliedLineText"
                                        Style="{StaticResource SomStatus}"
                                        Text="{Binding AppliedLine}"
                                        Visibility="{Binding HasAppliedLine, Converter={StaticResource BoolToVisibility}}" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>
                        </StackPanel>
                    </local:SettingsSection>

                    <local:SettingsSection
                        x:Name="OutputsSection"
                        Header="Saídas de áudio"
                        Style="{StaticResource SettingsSectionStyle}"
                        Subtitle="Por onde o som sai na mesa: o padrão do Windows, o player e o Holyrics.">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="DefaultOutputRow"
                                Title="Saída padrão do Windows"
                                Info="A saída de som que o Windows usa para tudo que não tem saída própria.&#10;Se o aparelho escolhido não estiver ligado, o app espera e não mexe em nada."
                                Style="{StaticResource SettingRowStyle}">
                                <ComboBox
                                    x:Name="DefaultOutputCombo"
                                    AutomationProperties.Name="Saída padrão do Windows"
                                    ItemsSource="{Binding DefaultOutput.Choices}"
                                    SelectedItem="{Binding DefaultOutput.Selected, Mode=TwoWay}"
                                    Style="{StaticResource OutputCombo}" />
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="DefaultOutputStatus"
                                        Style="{StaticResource SomStatus}"
                                        Text="{Binding DefaultOutput.Status}"
                                        Visibility="{Binding DefaultOutput.HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="LockRow"
                                Title="Travar a saída padrão neste dispositivo"
                                Info="Se o Windows trocar a saída padrão (por exemplo quando um aparelho USB liga), o app põe de volta neste dispositivo.&#10;É o único lugar onde isto se liga e desliga."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="LockSwitch"
                                    AutomationProperties.Name="Travar a saída padrão neste dispositivo"
                                    IsChecked="{Binding LockOutput, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="PlayerOutputRow"
                                Title="Player"
                                Info="Por onde sai a música do player (a saída 3-4 da mesa). Se o aparelho não estiver ligado, toca na saída padrão do Windows."
                                Style="{StaticResource SettingRowStyle}">
                                <ComboBox
                                    x:Name="PlayerOutputCombo"
                                    AutomationProperties.Name="Saída do player"
                                    ItemsSource="{Binding PlayerOutput.Choices}"
                                    SelectedItem="{Binding PlayerOutput.Selected, Mode=TwoWay}"
                                    Style="{StaticResource OutputCombo}" />
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="PlayerOutputStatus"
                                        Style="{StaticResource SomStatus}"
                                        Text="{Binding PlayerOutput.Status}"
                                        Visibility="{Binding PlayerOutput.HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="HolyricsOutputRow"
                                Title="Holyrics"
                                Info="Por onde sai o som do Holyrics (a saída 1-2 da mesa). É a saída por programa do Windows, a mesma de Configurações, Sistema, Som, Misturador de volume. Se o aparelho não estiver ligado, o Holyrics fica como está."
                                Style="{StaticResource SettingRowStyle}">
                                <ComboBox
                                    x:Name="HolyricsOutputCombo"
                                    AutomationProperties.Name="Saída do Holyrics"
                                    ItemsSource="{Binding HolyricsOutput.Choices}"
                                    SelectedItem="{Binding HolyricsOutput.Selected, Mode=TwoWay}"
                                    Style="{StaticResource OutputCombo}" />
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="HolyricsOutputStatus"
                                        Style="{StaticResource SomStatus}"
                                        Text="{Binding HolyricsOutput.Status}"
                                        Visibility="{Binding HolyricsOutput.HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="HolyricsRouteRow"
                                Title="Definir a saída do Holyrics"
                                Info="Ligado: quando o Holyrics começa a tocar, o app põe a saída dele na escolhida acima.&#10;Desligado: o app nunca mexe na saída do Holyrics."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="HolyricsRouteSwitch"
                                    AutomationProperties.Name="Definir a saída do Holyrics"
                                    IsChecked="{Binding HolyricsRoute, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>
                        </StackPanel>
                    </local:SettingsSection>
                </StackPanel>

                <!-- Right: the music, the alarms and how the player behaves. -->
                <StackPanel
                    x:Name="RightColumn"
                    Grid.Column="2">
                    <local:SettingsSection
                        x:Name="PlaylistsSection"
                        Header="Playlists"
                        Style="{StaticResource SettingsSectionStyle}"
                        Subtitle="De onde vem a música: cada lista é uma pasta do PC.">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="PlaylistRow"
                                Title="Lista de músicas"
                                Info="Cada lista é uma pasta do PC (com as subpastas). A música que entra na pasta aparece na lista em poucos segundos.&#10;Excluir a lista só tira ela daqui: as músicas continuam na pasta."
                                Style="{StaticResource SettingRowStyle}">
                                <ComboBox
                                    x:Name="PlaylistCombo"
                                    AutomationProperties.Name="Lista de músicas"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Player.Playlists}"
                                    SelectedValue="{Binding Player.CurrentPlaylist, Mode=TwoWay}"
                                    SelectedValuePath="Name"
                                    Style="{StaticResource OutputCombo}"
                                    Visibility="{Binding IsNotRenaming, Converter={StaticResource BoolToVisibility}}" />
                                <local:SettingRow.Footer>
                                    <StackPanel>
                                        <Grid
                                            x:Name="RenameHost"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="RenameBox"
                                                AutomationProperties.Name="Novo nome da lista"
                                                Style="{StaticResource IbtSmallInput}"
                                                Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                                                TextAlignment="Left" />
                                            <Button
                                                x:Name="RenameOkButton"
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="Salvar o nome"
                                                Command="{Binding CommitRenameCommand}"
                                                Style="{StaticResource IbtPrimaryButton}">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="{StaticResource LucideCheck}"
                                                    Style="{StaticResource LucideIcon}" />
                                            </Button>
                                            <Button
                                                x:Name="RenameCancelButton"
                                                Grid.Column="2"
                                                Margin="4,0,0,0"
                                                AutomationProperties.Name="Cancelar"
                                                Command="{Binding CancelRenameCommand}"
                                                Style="{StaticResource IbtIconButton}">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Data="{StaticResource LucideX}"
                                                    Style="{StaticResource LucideIcon}" />
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            x:Name="PlaylistMessageText"
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding PlaylistMessage}"
                                            Visibility="{Binding HasPlaylistMessage, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="FolderRow"
                                Title="Pasta da lista"
                                Info="A pasta do PC onde estão as músicas desta lista."
                                Style="{StaticResource SettingRowStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Name="ChangeFolderButton"
                                        AutomationProperties.Name="Trocar a pasta"
                                        Command="{Binding ChangeFolderCommand}"
                                        Style="{StaticResource IbtButton}"
                                        ToolTip="Escolher outra pasta para esta lista">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{StaticResource LucideFolder}"
                                                Style="{StaticResource LucideIcon}" />
                                            <TextBlock Margin="6,0,0,0" Text="Trocar a pasta" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RefreshButton"
                                        Margin="8,0,0,0"
                                        AutomationProperties.Name="Atualizar"
                                        Command="{Binding Player.RefreshCommand}"
                                        Style="{StaticResource IbtButton}"
                                        ToolTip="Ler a pasta de novo e conferir as saídas">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{StaticResource LucideRotateCcw}"
                                                Style="{StaticResource LucideIcon}" />
                                            <TextBlock Margin="6,0,0,0" Text="Atualizar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="PlaylistInfoText"
                                        Style="{StaticResource SomStatus}"
                                        Text="{Binding PlaylistInfo}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTip="{Binding PlaylistInfo}" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <Border
                                x:Name="PlaylistActions"
                                Padding="0,12,0,0"
                                BorderBrush="{StaticResource IbtLineBrush}"
                                BorderThickness="0,1,0,0">
                                <WrapPanel>
                                    <Button
                                        x:Name="AddPlaylistButton"
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="Adicionar lista"
                                        Command="{Binding AddPlaylistCommand}"
                                        Style="{StaticResource IbtButton}"
                                        ToolTip="Adicionar uma lista: escolha a pasta da música">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{StaticResource LucidePlus}"
                                                Style="{StaticResource LucideIcon}" />
                                            <TextBlock Margin="6,0,0,0" Text="Adicionar" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RenamePlaylistButton"
                                        Margin="0,0,8,0"
                                        AutomationProperties.Name="Renomear lista"
                                        Command="{Binding StartRenameCommand}"
                                        Style="{StaticResource IbtButton}"
                                        ToolTip="Renomear esta lista">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{StaticResource LucidePencil}"
                                                Style="{StaticResource LucideIcon}" />
                                            <TextBlock Margin="6,0,0,0" Text="Renomear" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RemovePlaylistButton"
                                        AutomationProperties.Name="Excluir lista"
                                        Command="{Binding RemovePlaylistCommand}"
                                        Style="{StaticResource IbtButton}"
                                        ToolTip="Excluir esta lista (as músicas ficam na pasta)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{StaticResource LucideTrash2}"
                                                Style="{StaticResource LucideIcon}" />
                                            <TextBlock Margin="6,0,0,0" Text="Excluir" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Border>
                        </StackPanel>
                    </local:SettingsSection>

                    <local:SettingsSection
                        x:Name="AlarmsSection"
                        Header="Despertadores"
                        Style="{StaticResource SettingsSectionStyle}"
                        Subtitle="Começam a música sozinhos, na hora e nos dias marcados.">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="AlarmsOnRow"
                                Title="Despertadores ligados"
                                Info="Cada despertador começa a música sozinho, na hora, nos dias marcados. Se o PC abrir depois da hora mas antes do limite, a música começa na hora que ele abrir. Nunca para a música que já está tocando."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="AlarmsOnSwitch"
                                    AutomationProperties.Name="Despertadores ligados"
                                    IsChecked="{Binding Player.AlarmsEnabled, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>

                            <ItemsControl
                                x:Name="AlarmList"
                                Focusable="False"
                                ItemTemplate="{StaticResource AlarmTemplate}"
                                ItemsSource="{Binding Alarms}" />

                            <Border
                                Padding="0,12,0,0"
                                BorderBrush="{StaticResource IbtLineBrush}"
                                BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <Button
                                        x:Name="AddAlarmButton"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Adicionar despertador"
                                        Command="{Binding AddAlarmCommand}"
                                        Style="{StaticResource IbtButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Width="14"
                                                Height="14"
                                                Data="{StaticResource LucidePlus}"
                                                Style="{StaticResource LucideIcon}" />
                                            <TextBlock Margin="6,0,0,0" Text="Adicionar despertador" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel
                                        Margin="2,10,0,0"
                                        Orientation="Horizontal">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource LucideClock}"
                                            Style="{StaticResource LucideIcon}"
                                            TextElement.Foreground="{StaticResource IbtMutedBrush}" />
                                        <TextBlock
                                            x:Name="AlarmsNextText"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{StaticResource IbtMutedBrush}"
                                            Text="{Binding Player.NextAlarmText}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </local:SettingsSection>

                    <local:SettingsSection
                        x:Name="BehaviorSection"
                        Header="Comportamento do player"
                        Style="{StaticResource SettingsSectionStyle}"
                        Subtitle="Como o volume sobe e desce, e se as teclas de mídia do teclado mandam.">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="StopFadeRow"
                                Title="Ao parar"
                                Info="Quanto dura a descida do volume ao pausar ou parar (pelo botão, pela API do Holyrics ou pelas teclas). Seco para na hora, sem estalo."
                                Style="{StaticResource SettingRowStyle}">
                                <Border
                                    BorderBrush="{StaticResource IbtLineBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="8">
                                    <ItemsControl
                                        x:Name="StopFadeList"
                                        Focusable="False"
                                        ItemTemplate="{StaticResource FadeButton}"
                                        ItemsSource="{Binding StopFadeOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="AlarmFadeRow"
                                Title="Ao começar pelo despertador"
                                Info="Quanto dura a subida do volume quando um despertador começa a música. Seco começa direto no volume."
                                Style="{StaticResource SettingRowStyle}">
                                <Border
                                    BorderBrush="{StaticResource IbtLineBrush}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    CornerRadius="8">
                                    <ItemsControl
                                        x:Name="AlarmFadeList"
                                        Focusable="False"
                                        ItemTemplate="{StaticResource FadeButton}"
                                        ItemsSource="{Binding AlarmFadeOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Border>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="MediaKeysRow"
                                Title="Teclas de mídia"
                                Info="As teclas de play/pausa, próxima, anterior e parar do teclado comandam o player. O app só ouve essas teclas; as outras (e o que é digitado) ele não guarda."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="MediaKeysSwitch"
                                    AutomationProperties.Name="Teclas de mídia controlam o player"
                                    IsChecked="{Binding Player.MediaKeys, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>
                        </StackPanel>
                    </local:SettingsSection>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
