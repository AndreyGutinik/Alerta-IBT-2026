<ui:FluentWindow
    x:Class="AlertaIBT.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels"
    Title="Alerta-IBT"
    Width="1100"
    Height="720"
    MinWidth="900"
    MinHeight="600"
    Background="{StaticResource IbtBackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    FontFamily="{StaticResource MarbleFont}"
    FontSize="13"
    Foreground="{StaticResource IbtTextBrush}"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    WindowStartupLocation="Manual">

    <Grid Background="{StaticResource IbtBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="Alerta-IBT"
            Grid.Row="0"
            Background="#0D0D10"
            CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/AlertaIBT;component/Assets/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side bar: the logo, the three tabs, and at the bottom the small status list. -->
            <Border
                Padding="10,12"
                BorderBrush="{StaticResource IbtLineBrush}"
                BorderThickness="0,0,1,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#0A0A0C" />
                        <GradientStop Offset="1" Color="#0E0E12" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="6,4,6,12" Orientation="Horizontal">
                        <Image
                            Width="24"
                            Height="24"
                            Source="pack://application:,,,/AlertaIBT;component/Assets/app.ico" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14.5"
                            FontWeight="Bold"
                            Text="Alerta-IBT" />
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <Button
                            x:Name="HomeTab"
                            AutomationProperties.Name="Início"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="{x:Static vm:MainTab.Home}"
                            Style="{StaticResource IbtTabButton}"
                            Tag="{Binding IsHomeSelected}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideHouse}"
                                    Style="{StaticResource LucideIcon}" />
                                <TextBlock Margin="10,0,0,0" Text="Início" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CorrectionTab"
                            Margin="0,4,0,0"
                            AutomationProperties.Name="Correção"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="{x:Static vm:MainTab.Correction}"
                            Style="{StaticResource IbtTabButton}"
                            Tag="{Binding IsCorrectionSelected}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideSpellCheck}"
                                    Style="{StaticResource LucideIcon}" />
                                <TextBlock Margin="10,0,0,0" Text="Correção" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SettingsTab"
                            Margin="0,4,0,0"
                            AutomationProperties.Name="Configurações"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="{x:Static vm:MainTab.Settings}"
                            Style="{StaticResource IbtTabButton}"
                            Tag="{Binding IsSettingsSelected}">
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideSettings}"
                                    Style="{StaticResource LucideIcon}" />
                                <TextBlock Margin="10,0,0,0" Text="Configurações" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Telegram, Site, LED, Barra, Gemini: small, light, with a dot; the tooltip has the detail. -->
                    <Border
                        Grid.Row="3"
                        Padding="0,8,0,0"
                        BorderBrush="{StaticResource IbtLineBrush}"
                        BorderThickness="0,1,0,0">
                        <ItemsControl x:Name="StatusList" ItemsSource="{Binding Status}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatusRow}">
                                    <StackPanel
                                        x:Name="Row"
                                        Margin="0,0,0,0"
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding Tip}"
                                        ToolTipService.InitialShowDelay="150"
                                        ToolTipService.Placement="Right">
                                        <Border
                                            Width="6"
                                            Height="6"
                                            Margin="10,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding Light, Converter={StaticResource StatusLightBrush}}"
                                            CornerRadius="3" />
                                        <TextBlock
                                            x:Name="RowText"
                                            Padding="0,2"
                                            FontSize="10.5"
                                            FontWeight="Light"
                                            Foreground="#6F6A63"
                                            Text="{Binding Label}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowText" Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Grid>
            </Border>

            <!-- The three tabs stay alive (their text, scroll and state survive a switch); only one is visible. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- One line while an update downloads or installs ("Baixando a atualização 8.0.1…", "Instalando e reiniciando…"). -->
                <Border
                    x:Name="UpdateBanner"
                    Padding="16,7"
                    Background="{StaticResource IbtAccentSoftBrush}"
                    BorderBrush="{StaticResource IbtLineBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding HasUpdateNotice, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="14"
                            Height="14"
                            Data="{StaticResource LucideDownload}"
                            Style="{StaticResource LucideIcon}"
                            TextElement.Foreground="{StaticResource IbtOkBrush}" />
                        <TextBlock
                            x:Name="UpdateBannerText"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource IbtOkBrush}"
                            Text="{Binding UpdateNotice}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <local:HomePage
                        x:Name="HomePage"
                        DataContext="{Binding Home}"
                        Visibility="{Binding DataContext.IsHomeSelected, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource BoolToVisibility}}" />
                    <local:CorrectionPage
                        x:Name="CorrectionPage"
                        DataContext="{Binding Correction}"
                        Visibility="{Binding DataContext.IsCorrectionSelected, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource BoolToVisibility}}" />
                    <local:SettingsPage
                        x:Name="SettingsPage"
                        DataContext="{Binding Settings}"
                        Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
