<UserControl
    x:Class="AlertaIBT.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views"
    xmlns:theme="clr-namespace:AlertaIBT.App.Theme"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels">

    <!--
        The Configurações tab, in the cards of the design system (Theme/SettingsStyles.xaml): every group is its own card with an icon in its header and one
        block per setting. Two columns (one under about 1000 px of window). Left: the bar, its preview, Telegram, the site. Right: alerts, mouse, quick panel,
        history, updates, the Gemini model, the system. The diagnostics are folded at the bottom.
    -->

    <UserControl.Resources>
        <!-- A small label above a box. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource IbtTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="9,7,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style
            x:Key="FontPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=FontBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TokenPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=TokenEntryBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SitePasswordPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=SitePasswordBox}" Value="filled">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SiteUrlPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=SiteUrlBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ChatPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=ChatBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A box for a shortcut: click it and press the keys (read only; the keys are captured by the page). -->
        <Style
            x:Key="HotkeyInput"
            BasedOn="{StaticResource IbtFieldInput}"
            TargetType="TextBox">
            <Setter Property="MinWidth" Value="136" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>

        <!-- The block of one field: an icon and a label on top, the box under them (the block takes the 8 px under itself). -->
        <Style
            x:Key="FieldBlock"
            BasedOn="{StaticResource IbtBlock}"
            TargetType="Border">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- The chip that says how the last manual backup action ended: green when it worked, red when it did not. -->
        <Style x:Key="BackupChip" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderBrush" Value="#4D86E4AD" />
            <Setter Property="Background" Value="#0F86E4AD" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource IbtOkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResultKind}" Value="Error">
                    <Setter Property="BorderBrush" Value="#59FF5C5C" />
                    <Setter Property="Background" Value="#14FF5C5C" />
                    <Setter Property="TextElement.Foreground" Value="#FF9D9D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1280"
            Margin="24">
            <Grid Margin="0,0,0,24">
                <TextBlock Style="{StaticResource IbtPageTitle}" Text="Configurações" />
                <Border
                    x:Name="SavedBadge"
                    HorizontalAlignment="Right"
                    Style="{StaticResource IbtSavedBadge}">
                    <TextBlock FontSize="12" Text="{Binding Saver.Label}" />
                </Border>
            </Grid>

            <theme:AdaptiveGrid
                x:Name="Columns"
                Gap="24"
                MaxColumns="2"
                MinColumnWidth="400">

                <!-- ===== Left: the bar, its preview, Telegram, the site ===== -->
                <StackPanel x:Name="LeftColumn">
                    <local:CardSection
                        x:Name="BarSection"
                        Header="Barra no LED"
                        Icon="{StaticResource LucideMonitor}"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <local:SettingRow
                                x:Name="PositionRow"
                                Title="Posição"
                                Icon="{StaticResource LucidePanelTop}"
                                Style="{StaticResource SettingRowStyle}">
                                <Border Style="{StaticResource IbtSegmentedFrame}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="TopOption"
                                            AutomationProperties.Name="Topo"
                                            IsChecked="{Binding IsTop, Mode=TwoWay}"
                                            Style="{StaticResource IbtSegItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    Data="{StaticResource LucidePanelTop}"
                                                    Style="{StaticResource LucideIcon}" />
                                                <TextBlock Text="Topo" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="BottomOption"
                                            AutomationProperties.Name="Rodapé"
                                            IsChecked="{Binding IsBottom, Mode=TwoWay}"
                                            Style="{StaticResource IbtSegItem}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    Data="{StaticResource LucidePanelBottom}"
                                                    Style="{StaticResource LucideIcon}" />
                                                <TextBlock Text="Rodapé" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </local:SettingRow>

                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <Grid MinHeight="24">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Margin="0,0,12,0"
                                                Data="{StaticResource LucideMoveVertical}"
                                                Style="{StaticResource IbtRowIcon}" />
                                            <TextBlock Style="{StaticResource IbtRowLabel}" Text="Tamanho" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="SizeOutput"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Text="{Binding SizeLabel}" />
                                    </Grid>
                                    <Slider
                                        x:Name="SizeSlider"
                                        Margin="0,8,0,0"
                                        AutomationProperties.Name="Tamanho da barra"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="8"
                                        Maximum="{Binding MaxHeight, Mode=OneTime}"
                                        Minimum="{Binding MinHeight, Mode=OneTime}"
                                        SmallChange="2"
                                        TickFrequency="2"
                                        Value="{Binding BarHeight, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <Grid MinHeight="24">
                                        <StackPanel Orientation="Horizontal">
                                            <Path
                                                Margin="0,0,12,0"
                                                Data="{StaticResource LucideGauge}"
                                                Style="{StaticResource IbtRowIcon}" />
                                            <TextBlock Style="{StaticResource IbtRowLabel}" Text="Velocidade" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="SpeedOutput"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Text="{Binding SpeedLabel}" />
                                    </Grid>
                                    <Slider
                                        x:Name="SpeedSlider"
                                        Margin="0,8,0,0"
                                        AutomationProperties.Name="Velocidade da barra"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="30"
                                        Maximum="{Binding MaxSpeed, Mode=OneTime}"
                                        Minimum="{Binding MinSpeed, Mode=OneTime}"
                                        SmallChange="10"
                                        TickFrequency="10"
                                        Value="{Binding BarSpeed, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <!-- Avançado: the letter, the margin, the colors and the animation. -->
                            <Border Style="{StaticResource FieldBlock}">
                                <Expander
                                    x:Name="BarAdvanced"
                                    Style="{StaticResource IbtExpander}">
                                    <Expander.Header>
                                        <StackPanel
                                            Orientation="Horizontal"
                                            ToolTip="Letra separada, margem, cores e animação">
                                            <Path
                                                Margin="0,0,12,0"
                                                Data="{StaticResource LucideSlidersHorizontal}"
                                                Style="{StaticResource IbtRowIcon}" />
                                            <TextBlock Style="{StaticResource IbtRowLabel}" Text="Avançado" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource FieldLabel}" Text="Letra (px)" />
                                            <Grid>
                                                <TextBox
                                                    x:Name="FontBox"
                                                    AutomationProperties.Name="Tamanho da letra"
                                                    LostFocus="OnFieldLostFocus"
                                                    Style="{StaticResource IbtFieldInput}"
                                                    Tag="{Binding FontSize}"
                                                    Text="{Binding FontSize.Text, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource FontPlaceholder}" Text="automática (64%)" />
                                            </Grid>
                                            <TextBlock
                                                Style="{StaticResource IbtHint}"
                                                Text="{Binding FontSize.Hint}"
                                                Visibility="{Binding FontSize.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource FieldLabel}" Text="Margem (px)" />
                                            <TextBox
                                                x:Name="MarginBox"
                                                AutomationProperties.Name="Margem do texto"
                                                LostFocus="OnFieldLostFocus"
                                                Style="{StaticResource IbtFieldInput}"
                                                Tag="{Binding Margin}"
                                                Text="{Binding Margin.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock
                                                Style="{StaticResource IbtHint}"
                                                Text="{Binding Margin.Hint}"
                                                Visibility="{Binding Margin.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource FieldLabel}" Text="Cor da barra" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    Background="{Binding Background.Accepted, Converter={StaticResource HexColorBrush}}"
                                                    BorderBrush="{StaticResource IbtBorderStrongBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" />
                                                <TextBox
                                                    x:Name="BackgroundBox"
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="Cor da barra"
                                                    LostFocus="OnFieldLostFocus"
                                                    Style="{StaticResource IbtFieldInput}"
                                                    Tag="{Binding Background}"
                                                    Text="{Binding Background.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <TextBlock
                                                Style="{StaticResource IbtHint}"
                                                Text="{Binding Background.Hint}"
                                                Visibility="{Binding Background.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="0,0,0,12">
                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource FieldLabel}" Text="Cor do texto" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    Margin="0,0,8,0"
                                                    Background="{Binding Foreground.Accepted, Converter={StaticResource HexColorBrush}}"
                                                    BorderBrush="{StaticResource IbtBorderStrongBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8" />
                                                <TextBox
                                                    x:Name="ForegroundBox"
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="Cor do texto"
                                                    LostFocus="OnFieldLostFocus"
                                                    Style="{StaticResource IbtFieldInput}"
                                                    Tag="{Binding Foreground}"
                                                    Text="{Binding Foreground.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                            <TextBlock
                                                Style="{StaticResource IbtHint}"
                                                Text="{Binding Foreground.Hint}"
                                                Visibility="{Binding Foreground.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock Margin="0,0,0,6" Style="{StaticResource FieldLabel}" Text="Animação (ms)" />
                                            <TextBox
                                                x:Name="SlideBox"
                                                AutomationProperties.Name="Tempo da animação"
                                                LostFocus="OnFieldLostFocus"
                                                Style="{StaticResource IbtFieldInput}"
                                                Tag="{Binding SlideMs}"
                                                Text="{Binding SlideMs.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock
                                                Style="{StaticResource IbtHint}"
                                                Text="{Binding SlideMs.Hint}"
                                                Visibility="{Binding SlideMs.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </local:CardSection>

                    <local:CardSection
                        x:Name="PreviewSection"
                        Margin="0,24,0,0"
                        Header="Prévia no LED"
                        Icon="{StaticResource LucideEye}"
                        Info="Como a barra fica no LED de 2560x768, com o texto de exemplo."
                        Style="{StaticResource IbtCardSectionStyle}">
                        <local:CardSection.HeaderActions>
                            <Button
                                x:Name="ShowBarButton"
                                AutomationProperties.Name="Mostrar barra 3 s no LED"
                                Command="{Binding ShowBarCommand}"
                                Style="{StaticResource IbtToolButton}"
                                ToolTip="Mostrar a barra 3 s no LED">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucidePlay}"
                                    Style="{StaticResource LucideIcon}" />
                            </Button>
                        </local:CardSection.HeaderActions>
                        <StackPanel>
                            <Border
                                BorderBrush="{StaticResource IbtBorderBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="8">
                                <local:BarPreviewControl
                                    x:Name="Preview"
                                    Bar="{Binding PreviewBar}"
                                    SampleText="{Binding SampleText}" />
                            </Border>
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding BarTestMessage}"
                                Visibility="{Binding HasBarTestMessage, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </local:CardSection>

                    <local:CardSection
                        x:Name="TelegramSection"
                        Margin="0,24,0,0"
                        Header="Telegram"
                        Icon="{StaticResource LucideSend}"
                        Info="Só mensagens que começam com # vão para o telão.&#10;Precisa de modelo, cor e placa.&#10;Exemplo: #corolla prata abc1d23 vidro aberto"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Margin="0,0,12,0"
                                            Data="{StaticResource LucideKeyRound}"
                                            Style="{StaticResource IbtRowIcon}" />
                                        <TextBlock Style="{StaticResource IbtRowLabel}" Text="Token do bot" />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox
                                                x:Name="TokenLockedBox"
                                                AutomationProperties.Name="Token do bot (guardado)"
                                                IsEnabled="False"
                                                IsReadOnly="True"
                                                Style="{StaticResource IbtFieldInput}"
                                                Text="{x:Static vm:SecretFieldViewModel.Mask}"
                                                Visibility="{Binding Token.IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                            <Grid Visibility="{Binding Token.IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox
                                                    x:Name="TokenEntryBox"
                                                    AutomationProperties.Name="Novo token do bot"
                                                    Style="{StaticResource IbtFieldInput}"
                                                    Text="{Binding Token.Entry, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Style="{StaticResource TokenPlaceholder}" Text="Cole o token aqui" />
                                            </Grid>
                                        </Grid>
                                        <Button
                                            x:Name="TokenLockButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="{Binding Token.LockButtonText}"
                                            Click="OnTokenLockClick"
                                            Command="{Binding Token.ToggleLockCommand}"
                                            Style="{StaticResource IbtToolButton}"
                                            ToolTip="{Binding Token.LockButtonText}"
                                            Visibility="{Binding Token.CanLock, Converter={StaticResource BoolToVisibility}}">
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{Binding Token.LockIconKey, Converter={StaticResource GeometryKey}}"
                                                Style="{StaticResource LucideIcon}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding Token.Hint}"
                                        Visibility="{Binding Token.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Margin="0,0,12,0"
                                            Data="{StaticResource LucideMessageSquare}"
                                            Style="{StaticResource IbtRowIcon}" />
                                        <TextBlock Style="{StaticResource IbtRowLabel}" Text="Chat ID do grupo" />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <TextBox
                                            x:Name="ChatBox"
                                            AutomationProperties.Name="Chat ID do grupo"
                                            IsEnabled="{Binding ChatIdEnabled}"
                                            Style="{StaticResource IbtFieldInput}"
                                            Text="{Binding ChatIdText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource ChatPlaceholder}" Text="-100..." />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding ChatIdHint}"
                                        Visibility="{Binding HasChatIdHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </local:CardSection>

                    <local:CardSection
                        x:Name="SiteSection"
                        Margin="0,24,0,0"
                        Header="Site"
                        Icon="{StaticResource LucideGlobe}"
                        Info="Liga o PC ao site alertaibt.web.app: os avisos enviados pelo celular chegam aqui.&#10;Preencha com os dados que o script scripts\publicar-site.ps1 mostrou&#10;(estão em artifacts\credenciais-pc.txt) e ligue a chave."
                        Style="{StaticResource IbtCardSectionStyle}">
                        <local:CardSection.HeaderActions>
                            <ToggleButton
                                x:Name="SiteSwitch"
                                AutomationProperties.Name="Site ligado"
                                IsChecked="{Binding SiteEnabled, Mode=TwoWay}"
                                Style="{StaticResource IbtPowerToggle}"
                                ToolTip="Site ligado" />
                        </local:CardSection.HeaderActions>
                        <StackPanel Margin="0,0,0,-8">
                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Margin="0,0,12,0"
                                            Data="{StaticResource LucideGlobe}"
                                            Style="{StaticResource IbtRowIcon}" />
                                        <TextBlock Style="{StaticResource IbtRowLabel}" Text="URL do banco" />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <TextBox
                                            x:Name="SiteUrlBox"
                                            AutomationProperties.Name="URL do banco"
                                            LostFocus="OnFieldLostFocus"
                                            Style="{StaticResource IbtFieldInput}"
                                            Tag="{Binding SiteUrl}"
                                            Text="{Binding SiteUrl.Text, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource SiteUrlPlaceholder}" Text="https://alertaibt-default-rtdb.firebaseio.com" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding SiteUrl.Hint}"
                                        Visibility="{Binding SiteUrl.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Margin="0,0,12,0"
                                            Data="{StaticResource LucideKeyRound}"
                                            Style="{StaticResource IbtRowIcon}" />
                                        <TextBlock Style="{StaticResource IbtRowLabel}" Text="Chave da API (web)" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="SiteApiKeyBox"
                                        Margin="0,10,0,0"
                                        AutomationProperties.Name="Chave da API (web)"
                                        LostFocus="OnFieldLostFocus"
                                        Style="{StaticResource IbtFieldInput}"
                                        Tag="{Binding SiteApiKey}"
                                        Text="{Binding SiteApiKey.Text, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding SiteApiKey.Hint}"
                                        Visibility="{Binding SiteApiKey.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Margin="0,0,12,0"
                                            Data="{StaticResource LucideMonitor}"
                                            Style="{StaticResource IbtRowIcon}" />
                                        <TextBlock Style="{StaticResource IbtRowLabel}" Text="E-mail do PC" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="SiteEmailBox"
                                        Margin="0,10,0,0"
                                        AutomationProperties.Name="E-mail do PC"
                                        LostFocus="OnFieldLostFocus"
                                        Style="{StaticResource IbtFieldInput}"
                                        Tag="{Binding SiteEmail}"
                                        Text="{Binding SiteEmail.Text, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding SiteEmail.Hint}"
                                        Visibility="{Binding SiteEmail.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Margin="0,0,12,0"
                                            Data="{StaticResource LucideLock}"
                                            Style="{StaticResource IbtRowIcon}" />
                                        <TextBlock Style="{StaticResource IbtRowLabel}" Text="Senha do PC" />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox
                                                x:Name="SitePasswordLockedBox"
                                                AutomationProperties.Name="Senha do PC (guardada)"
                                                IsEnabled="False"
                                                IsReadOnly="True"
                                                Style="{StaticResource IbtFieldInput}"
                                                Text="{x:Static vm:SecretFieldViewModel.Mask}"
                                                Visibility="{Binding SitePassword.IsLocked, Converter={StaticResource BoolToVisibility}}" />
                                            <Grid Visibility="{Binding SitePassword.IsEditing, Converter={StaticResource BoolToVisibility}}">
                                                <PasswordBox
                                                    x:Name="SitePasswordBox"
                                                    AutomationProperties.Name="Nova senha do PC"
                                                    PasswordChanged="OnSitePasswordChanged"
                                                    Style="{StaticResource IbtFieldPassword}" />
                                                <TextBlock Style="{StaticResource SitePasswordPlaceholder}" Text="Cole a senha aqui" />
                                            </Grid>
                                        </Grid>
                                        <Button
                                            x:Name="SitePasswordLockButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="{Binding SitePassword.LockButtonText}"
                                            Click="OnSitePasswordLockClick"
                                            Command="{Binding SitePassword.ToggleLockCommand}"
                                            Style="{StaticResource IbtToolButton}"
                                            ToolTip="{Binding SitePassword.LockButtonText}"
                                            Visibility="{Binding SitePassword.CanLock, Converter={StaticResource BoolToVisibility}}">
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{Binding SitePassword.LockIconKey, Converter={StaticResource GeometryKey}}"
                                                Style="{StaticResource LucideIcon}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding SitePassword.Hint}"
                                        Visibility="{Binding SitePassword.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </local:CardSection>

                    <!-- Backup: the critical settings in one file protected by a password, and the automatic copy. The data context is the Backup of the tab. -->
                    <local:CardSection
                        x:Name="BackupSection"
                        Margin="0,24,0,0"
                        DataContext="{Binding Backup}"
                        Header="Backup"
                        Icon="{StaticResource LucideArchive}"
                        Info="Guarda num arquivo, protegido por senha: Telegram (token e grupo), chave e modelo do Gemini, atalhos, barra (tamanho, velocidade, posição e tela do LED), conexão com o site (e se está ligado), regras fixas, Alertas ligados e a limpeza semanal.&#10;Não guarda playlists, câmeras, volumes, saídas, player, despertadores nem a janela.&#10;Sem a senha não dá para abrir o arquivo: guarde-a."
                        Style="{StaticResource IbtCardSectionStyle}">
                        <local:CardSection.HeaderActions>
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    x:Name="ExportBackupButton"
                                    AutomationProperties.Name="Exportar backup"
                                    Command="{Binding ExportCommand}"
                                    Style="{StaticResource IbtToolButton}"
                                    ToolTip="Exportar backup">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource LucideDownload}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <Button
                                    x:Name="RestoreBackupButton"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Restaurar backup"
                                    Command="{Binding RestoreCommand}"
                                    Style="{StaticResource IbtToolButton}"
                                    ToolTip="Restaurar backup">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource LucideUpload}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                            </StackPanel>
                        </local:CardSection.HeaderActions>
                        <StackPanel>
                            <Border
                                x:Name="BackupResultChip"
                                Style="{StaticResource BackupChip}"
                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock
                                    x:Name="BackupResultText"
                                    FontSize="12"
                                    Text="{Binding ResultText}" />
                            </Border>

                            <StackPanel Margin="0,0,0,-8">
                                <local:SettingRow
                                    x:Name="AutoBackupRow"
                                    Title="Cópia automática"
                                    Icon="{StaticResource LucideRefreshCw}"
                                    Info="Quando algum item do backup muda, grava um arquivo novo na pasta, 5 segundos depois da última mudança.&#10;Guarda só as 5 últimas cópias (arquivos ibt-backup-AAAAMMDD-HHmmss).&#10;A senha é pedida uma vez e fica protegida neste usuário do Windows."
                                    Style="{StaticResource SettingRowStyle}">
                                    <ToggleButton
                                        x:Name="AutoBackupSwitch"
                                        AutomationProperties.Name="Cópia automática"
                                        IsChecked="{Binding AutoEnabled, Mode=TwoWay}"
                                        Style="{StaticResource IbtSwitch}" />
                                </local:SettingRow>

                                <local:SettingRow
                                    x:Name="BackupFolderRow"
                                    Title="Pasta"
                                    Icon="{StaticResource LucideFolder}"
                                    Style="{StaticResource SettingRowStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="BackupFolderText"
                                            MaxWidth="200"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource IbtSecondaryText}"
                                            Text="{Binding FolderText}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding FolderTip}" />
                                        <Button
                                            x:Name="BackupFolderButton"
                                            AutomationProperties.Name="Escolher a pasta das cópias"
                                            Command="{Binding ChooseFolderCommand}"
                                            Style="{StaticResource IbtToolButton}"
                                            ToolTip="Escolher a pasta das cópias">
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{StaticResource LucideFolder}"
                                                Style="{StaticResource LucideIcon}" />
                                        </Button>
                                    </StackPanel>
                                </local:SettingRow>

                                <local:SettingRow
                                    x:Name="BackupStateRow"
                                    Title="Última cópia"
                                    Icon="{StaticResource LucideClock}"
                                    Style="{StaticResource SettingRowStyle}">
                                    <StackPanel
                                        Background="Transparent"
                                        Orientation="Horizontal"
                                        ToolTip="{Binding AutoTip}">
                                        <Ellipse
                                            x:Name="BackupStateDot"
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding AutoLight, Converter={StaticResource StatusLightBrush}}"
                                            Style="{StaticResource IbtStatusDot}" />
                                        <TextBlock
                                            x:Name="BackupStateText"
                                            Style="{StaticResource IbtSecondaryText}"
                                            Text="{Binding AutoText}" />
                                    </StackPanel>
                                </local:SettingRow>
                            </StackPanel>
                        </StackPanel>
                    </local:CardSection>
                </StackPanel>

                <!-- ===== Right: alerts, mouse, quick panel, history, updates, the Gemini model, the system ===== -->
                <StackPanel x:Name="RightColumn">
                    <local:CardSection
                        x:Name="AlertsSection"
                        Header="Alertas"
                        Icon="{StaticResource LucideBell}"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <local:SettingRow
                                x:Name="AlertsRow"
                                Title="Alertas ligados"
                                Icon="{StaticResource LucidePower}"
                                Info="Barra no LED, Telegram, site e API do overlay.&#10;Desligado, o app só cuida do som: a barra no LED, o Telegram, o site e a API do overlay (/overlay) ficam parados e o painel rápido esconde a parte dos avisos.&#10;Serve para o templo menor, que não usa o telão. O player, o som, o travamento do mouse, o histórico e as atualizações continuam funcionando.&#10;Ligando de novo, tudo volta a funcionar sozinho."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="AlertsSwitch"
                                    AutomationProperties.Name="Alertas ligados"
                                    IsChecked="{Binding AlertsEnabled, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="AlertsOffHint"
                                        Text="Alertas desligados: a barra, o Telegram, o site e a API do overlay estão parados. O som continua.">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource IbtHint}" TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Margin" Value="0,10,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlertsEnabled}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </local:SettingRow.Footer>
                            </local:SettingRow>
                        </StackPanel>
                    </local:CardSection>

                    <local:CardSection
                        x:Name="MouseSection"
                        Margin="0,24,0,0"
                        Header="Mouse"
                        Icon="{StaticResource LucideMouse}"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <local:SettingRow
                                x:Name="MouseLockRow"
                                Title="Travar o mouse na tela principal"
                                Icon="{StaticResource LucideLock}"
                                Info="Prende o cursor no monitor principal do Windows: ele não para mais no LED nem no retorno.&#10;Também liga e desliga pelo atalho abaixo e pelo ícone da bandeja."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="MouseLockSwitch"
                                    AutomationProperties.Name="Travar o mouse na tela principal"
                                    IsChecked="{Binding MouseLockEnabled, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="MouseLockHotkeyRow"
                                Title="Atalho para travar"
                                Icon="{StaticResource LucideKeyboard}"
                                Info="Clique no campo e aperte a nova combinação.&#10;Precisa ter Ctrl, Alt ou Win."
                                Style="{StaticResource SettingRowStyle}">
                                <TextBox
                                    x:Name="MouseLockHotkeyBox"
                                    AutomationProperties.Name="Atalho para travar o mouse"
                                    PreviewKeyDown="OnMouseLockHotkeyKeyDown"
                                    Style="{StaticResource HotkeyInput}"
                                    Text="{Binding MouseLockHotkeyDisplay, Mode=OneWay}" />
                                <local:SettingRow.Footer>
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="MouseLockHotkeyHintLine"
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding MouseLockHotkeyHint}"
                                            Visibility="{Binding HasMouseLockHotkeyHint, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            x:Name="MouseLockHotkeyProblemLine"
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding MouseLockHotkeyProblem}"
                                            Visibility="{Binding HasMouseLockHotkeyProblem, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="TripleCtrlRow"
                                Title="Ctrl 3 vezes traz o mouse ao centro"
                                Icon="{StaticResource LucideMouse}"
                                Info="Aperte Ctrl três vezes seguidas, rápido e sem outra tecla no meio: o mouse vai para o centro do monitor principal, onde quer que esteja.&#10;Funciona com o travamento ligado ou desligado. O app só conta os Ctrl; não guarda o que é digitado."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="TripleCtrlSwitch"
                                    AutomationProperties.Name="Ctrl 3 vezes traz o mouse ao centro"
                                    IsChecked="{Binding TripleCtrl, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>
                        </StackPanel>
                    </local:CardSection>

                    <local:CardSection
                        x:Name="QuickPanelSection"
                        Margin="0,24,0,0"
                        Header="Painel rápido"
                        Icon="{StaticResource LucideAppWindow}"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <local:SettingRow
                                x:Name="QuickPanelHotkeyRow"
                                Title="Atalho"
                                Icon="{StaticResource LucideKeyboard}"
                                Info="Clique no campo e aperte a nova combinação.&#10;Precisa ter Ctrl, Alt ou Win."
                                Style="{StaticResource SettingRowStyle}">
                                <TextBox
                                    x:Name="HotkeyBox"
                                    AutomationProperties.Name="Atalho do painel rápido"
                                    PreviewKeyDown="OnHotkeyKeyDown"
                                    Style="{StaticResource HotkeyInput}"
                                    Text="{Binding HotkeyDisplay, Mode=OneWay}" />
                                <local:SettingRow.Footer>
                                    <StackPanel>
                                        <TextBlock
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding HotkeyHint}"
                                            Visibility="{Binding HasHotkeyHint, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding HotkeyProblem}"
                                            Visibility="{Binding HasHotkeyProblem, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </local:SettingRow.Footer>
                            </local:SettingRow>
                        </StackPanel>
                    </local:CardSection>

                    <local:CardSection
                        x:Name="HistorySection"
                        Margin="0,24,0,0"
                        Header="Histórico"
                        Icon="{StaticResource LucideHistory}"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <local:SettingRow
                                x:Name="ClearHistoryRow"
                                Title="Limpar toda segunda-feira, 00:00"
                                Icon="{StaticResource LucideTrash2}"
                                Info="Apaga o histórico do PC e do site, e as mensagens do bot no Telegram com menos de 48 h.&#10;Se o PC estiver desligado nessa hora, a limpeza acontece quando ele ligar."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="ClearHistorySwitch"
                                    AutomationProperties.Name="Limpar histórico toda segunda-feira"
                                    IsChecked="{Binding ClearHistoryWeekly, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>
                        </StackPanel>
                    </local:CardSection>

                    <!-- The automatic update: the switch, the version with "Verificar agora", and how the last look ended. -->
                    <local:CardSection
                        x:Name="UpdatesSection"
                        Margin="0,24,0,0"
                        Header="Atualizações"
                        Icon="{StaticResource LucideDownload}"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <local:SettingRow
                                x:Name="AutoUpdateRow"
                                Title="Atualizar automaticamente ao abrir"
                                Icon="{StaticResource LucideRefreshCw}"
                                Info="Procura uma versão nova ao abrir o app e a cada 30 minutos.&#10;Se achar, baixa e instala sozinho, reiniciando, mas só quando não há aviso na fila nem na barra e a pregação não está pausada."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="AutoUpdateSwitch"
                                    AutomationProperties.Name="Atualizar automaticamente ao abrir"
                                    IsChecked="{Binding AutoUpdate, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="VersionRow"
                                Title="{Binding VersionText}"
                                Icon="{StaticResource LucideShieldCheck}"
                                Style="{StaticResource SettingRowStyle}">
                                <Button
                                    x:Name="CheckUpdateButton"
                                    AutomationProperties.Name="Verificar agora"
                                    Command="{Binding CheckUpdateCommand}"
                                    Style="{StaticResource IbtToolButton}"
                                    ToolTip="Verificar agora">
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="{StaticResource LucideRotateCcw}"
                                        Style="{StaticResource LucideIcon}" />
                                </Button>
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="UpdateResultLine"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding UpdateResultText}" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>
                        </StackPanel>
                    </local:CardSection>

                    <!-- The model of Gemini (it used to be in "Avançado" of the Correção tab). The data context is the correction of the window. -->
                    <local:CardSection
                        x:Name="GeminiSection"
                        Margin="0,24,0,0"
                        DataContext="{Binding DataContext.Correction, RelativeSource={RelativeSource AncestorType=Window}}"
                        Header="Modelo do Gemini"
                        Icon="{StaticResource LucideSparkles}"
                        Info="Deixe o padrão, a menos que o Google tire esse modelo do plano grátis.&#10;Em branco, vale o padrão."
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <Border Style="{StaticResource FieldBlock}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Margin="0,0,12,0"
                                            Data="{StaticResource LucideSparkles}"
                                            Style="{StaticResource IbtRowIcon}" />
                                        <TextBlock Style="{StaticResource IbtRowLabel}" Text="Modelo" />
                                    </StackPanel>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="ModelBox"
                                            AutomationProperties.Name="Modelo do Gemini"
                                            Style="{StaticResource IbtFieldInput}"
                                            Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button
                                            x:Name="ResetModelButton"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            AutomationProperties.Name="Voltar ao modelo padrão"
                                            Command="{Binding ResetModelCommand}"
                                            Style="{StaticResource IbtToolButton}"
                                            ToolTip="Voltar ao modelo padrão">
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{StaticResource LucideRotateCcw}"
                                                Style="{StaticResource LucideIcon}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding ModelHint}"
                                        Visibility="{Binding HasModelHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </local:CardSection>

                    <local:CardSection
                        x:Name="SystemSection"
                        Margin="0,24,0,0"
                        Header="Sistema"
                        Icon="{StaticResource LucideShieldCheck}"
                        Style="{StaticResource IbtCardSectionStyle}">
                        <StackPanel Margin="0,0,0,-8">
                            <local:SettingRow
                                x:Name="HideFromLiveRow"
                                Title="Esconder da live (OBS e NDI)"
                                Icon="{StaticResource LucideEye}"
                                Style="{StaticResource SettingRowStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        Data="{StaticResource LucideLock}"
                                        Style="{StaticResource LucideIcon}"
                                        TextElement.Foreground="{StaticResource IbtOkBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource IbtOkBrush}"
                                        Text="sempre ligado" />
                                </StackPanel>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="SiteStatusRow"
                                Title="Conexão com o site"
                                Icon="{StaticResource LucideGlobe}"
                                Style="{StaticResource SettingRowStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="10"
                                        Height="10"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Fill="{Binding SiteLight, Converter={StaticResource StatusLightBrush}}"
                                        Style="{StaticResource IbtStatusDot}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource IbtTextSecondaryBrush}"
                                        Text="{Binding SiteText}" />
                                </StackPanel>
                            </local:SettingRow>
                        </StackPanel>
                    </local:CardSection>
                </StackPanel>
            </theme:AdaptiveGrid>

            <!-- Diagnóstico: folded away; the logs live here. -->
            <Border
                x:Name="DiagnosticsCard"
                Margin="0,24,0,0"
                Style="{StaticResource IbtSurfaceCard}">
                <Expander
                    x:Name="DiagnosticsExpander"
                    DataContext="{Binding Diagnostics}"
                    IsExpanded="{Binding IsOpen, Mode=TwoWay}"
                    Style="{StaticResource IbtExpander}">
                    <Expander.Header>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Margin="0,0,10,0"
                                    Data="{StaticResource LucideScrollText}"
                                    Style="{StaticResource IbtHeaderIcon}" />
                                <TextBlock Style="{StaticResource IbtCardTitle}" Text="Diagnóstico" />
                            </StackPanel>
                            <TextBlock
                                x:Name="DiagnosticsMeta"
                                HorizontalAlignment="Right"
                                Style="{StaticResource IbtSecondaryText}"
                                Text="{Binding Meta}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Copiar logs"
                                Command="{Binding CopyCommand}"
                                Style="{StaticResource IbtToolButton}"
                                ToolTip="Copiar logs">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideCopy}"
                                    Style="{StaticResource LucideIcon}" />
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Exportar logs"
                                Command="{Binding ExportCommand}"
                                Style="{StaticResource IbtToolButton}"
                                ToolTip="Exportar logs">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideDownload}"
                                    Style="{StaticResource LucideIcon}" />
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Limpar logs"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource IbtDangerToolButton}"
                                ToolTip="Limpar logs">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideTrash2}"
                                    Style="{StaticResource LucideIcon}" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Margin="0,12,0,0"
                            Style="{StaticResource IbtSecondaryText}"
                            Text="{Binding Message}"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                        <Border
                            Margin="0,12,0,0"
                            Padding="12"
                            Background="{StaticResource IbtInsetBrush}"
                            BorderBrush="{StaticResource IbtBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LogList" ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{Binding Severity, Converter={StaticResource LogSeverityBrush}}"
                                                LineHeight="18"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
