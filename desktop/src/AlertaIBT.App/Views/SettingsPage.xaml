<UserControl
    x:Class="AlertaIBT.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels">

    <UserControl.Resources>
        <!-- A small label above a box. -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="11,9,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style
            x:Key="FontPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=FontBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="TokenPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=TokenEntryBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SitePasswordPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=SitePasswordBox}" Value="filled">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="SiteUrlPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=SiteUrlBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="ChatPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=ChatBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A box for a shortcut: click it and press the keys (read only; the keys are captured by the page). -->
        <Style
            x:Key="HotkeyInput"
            BasedOn="{StaticResource IbtInput}"
            TargetType="TextBox">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <Grid Margin="0,0,0,12">
                <TextBlock Style="{StaticResource IbtTitle}" Text="Configurações" />
                <Border
                    x:Name="SavedBadge"
                    HorizontalAlignment="Right"
                    Style="{StaticResource IbtSavedBadge}">
                    <TextBlock FontSize="12" Text="{Binding Saver.Label}" />
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <!-- Left: the bar and Telegram. -->
                <StackPanel>
                    <Border Style="{StaticResource IbtCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Barra no LED" />

                            <TextBlock Margin="0,10,0,6" Style="{StaticResource FieldLabel}" Text="Posição" />
                            <Border
                                HorizontalAlignment="Left"
                                BorderBrush="{StaticResource IbtLineBrush}"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        x:Name="TopOption"
                                        AutomationProperties.Name="Topo"
                                        Content="Topo"
                                        IsChecked="{Binding IsTop, Mode=TwoWay}"
                                        Style="{StaticResource IbtSegButton}" />
                                    <RadioButton
                                        x:Name="BottomOption"
                                        AutomationProperties.Name="Rodapé"
                                        Content="Rodapé"
                                        IsChecked="{Binding IsBottom, Mode=TwoWay}"
                                        Style="{StaticResource IbtSegButton}" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,12,0,0">
                                <TextBlock HorizontalAlignment="Left" Style="{StaticResource FieldLabel}" Text="Tamanho" />
                                <TextBlock
                                    x:Name="SizeOutput"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Text="{Binding SizeLabel}" />
                            </Grid>
                            <Slider
                                x:Name="SizeSlider"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="Tamanho da barra"
                                IsSnapToTickEnabled="True"
                                LargeChange="8"
                                Maximum="{Binding MaxHeight, Mode=OneTime}"
                                Minimum="{Binding MinHeight, Mode=OneTime}"
                                SmallChange="2"
                                TickFrequency="2"
                                Value="{Binding BarHeight, Mode=TwoWay}" />

                            <Grid Margin="0,12,0,0">
                                <TextBlock HorizontalAlignment="Left" Style="{StaticResource FieldLabel}" Text="Velocidade" />
                                <TextBlock
                                    x:Name="SpeedOutput"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Text="{Binding SpeedLabel}" />
                            </Grid>
                            <Slider
                                x:Name="SpeedSlider"
                                Margin="0,4,0,0"
                                AutomationProperties.Name="Velocidade da barra"
                                IsSnapToTickEnabled="True"
                                LargeChange="30"
                                Maximum="{Binding MaxSpeed, Mode=OneTime}"
                                Minimum="{Binding MinSpeed, Mode=OneTime}"
                                SmallChange="10"
                                TickFrequency="10"
                                Value="{Binding BarSpeed, Mode=TwoWay}" />

                            <Expander
                                x:Name="BarAdvanced"
                                Margin="0,12,0,0"
                                Style="{StaticResource IbtExpander}">
                                <Expander.Header>
                                    <TextBlock Text="Avançado: letra separada, margem, cores, animação" />
                                </Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Margin="0,0,0,5" Style="{StaticResource FieldLabel}" Text="Letra (px)" />
                                        <Grid>
                                            <TextBox
                                                x:Name="FontBox"
                                                AutomationProperties.Name="Tamanho da letra"
                                                LostFocus="OnFieldLostFocus"
                                                Style="{StaticResource IbtInput}"
                                                Tag="{Binding FontSize}"
                                                Text="{Binding FontSize.Text, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Style="{StaticResource FontPlaceholder}" Text="automática (64%)" />
                                        </Grid>
                                        <TextBlock
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding FontSize.Hint}"
                                            Visibility="{Binding FontSize.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Margin="0,0,0,5" Style="{StaticResource FieldLabel}" Text="Margem (px)" />
                                        <TextBox
                                            x:Name="MarginBox"
                                            AutomationProperties.Name="Margem do texto"
                                            LostFocus="OnFieldLostFocus"
                                            Style="{StaticResource IbtInput}"
                                            Tag="{Binding Margin}"
                                            Text="{Binding Margin.Text, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding Margin.Hint}"
                                            Visibility="{Binding Margin.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                        <TextBlock Margin="0,0,0,5" Style="{StaticResource FieldLabel}" Text="Cor da barra" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="30"
                                                Margin="0,0,6,0"
                                                Background="{Binding Background.Accepted, Converter={StaticResource HexColorBrush}}"
                                                BorderBrush="{StaticResource IbtLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8" />
                                            <TextBox
                                                x:Name="BackgroundBox"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Cor da barra"
                                                LostFocus="OnFieldLostFocus"
                                                Style="{StaticResource IbtInput}"
                                                Tag="{Binding Background}"
                                                Text="{Binding Background.Text, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding Background.Hint}"
                                            Visibility="{Binding Background.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Margin="0,0,0,10">
                                        <TextBlock Margin="0,0,0,5" Style="{StaticResource FieldLabel}" Text="Cor do texto" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="30"
                                                Margin="0,0,6,0"
                                                Background="{Binding Foreground.Accepted, Converter={StaticResource HexColorBrush}}"
                                                BorderBrush="{StaticResource IbtLineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8" />
                                            <TextBox
                                                x:Name="ForegroundBox"
                                                Grid.Column="1"
                                                AutomationProperties.Name="Cor do texto"
                                                LostFocus="OnFieldLostFocus"
                                                Style="{StaticResource IbtInput}"
                                                Tag="{Binding Foreground}"
                                                Text="{Binding Foreground.Text, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                        <TextBlock
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding Foreground.Hint}"
                                            Visibility="{Binding Foreground.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Margin="0,0,0,5" Style="{StaticResource FieldLabel}" Text="Animação (ms)" />
                                        <TextBox
                                            x:Name="SlideBox"
                                            AutomationProperties.Name="Tempo da animação"
                                            LostFocus="OnFieldLostFocus"
                                            Style="{StaticResource IbtInput}"
                                            Tag="{Binding SlideMs}"
                                            Text="{Binding SlideMs.Text, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding SlideMs.Hint}"
                                            Visibility="{Binding SlideMs.HasHint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource IbtCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Telegram" />
                                <Border
                                    AutomationProperties.Name="Dicas"
                                    Style="{StaticResource SectionInfo}"
                                    ToolTip="Só mensagens que começam com # vão para o telão.&#10;Precisa de modelo, cor e placa.&#10;Exemplo: #corolla prata abc1d23 vidro aberto">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideInfo}"
                                        Style="{StaticResource LucideIcon}" />
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,10,0,0" MinHeight="22">
                                <TextBlock HorizontalAlignment="Left" Style="{StaticResource FieldLabel}" Text="Token do bot" />
                                <Button
                                    x:Name="TokenLockButton"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="{Binding Token.LockButtonText}"
                                    Click="OnTokenLockClick"
                                    Command="{Binding Token.ToggleLockCommand}"
                                    Style="{StaticResource IbtLockButton}"
                                    Visibility="{Binding Token.CanLock, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Data="{Binding Token.LockIconKey, Converter={StaticResource GeometryKey}}"
                                            StrokeThickness="1.5"
                                            Style="{StaticResource LucideIcon}" />
                                        <TextBlock Margin="5,0,0,0" Text="{Binding Token.LockButtonText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox
                                x:Name="TokenLockedBox"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Token do bot (guardado)"
                                IsEnabled="False"
                                IsReadOnly="True"
                                Style="{StaticResource IbtInput}"
                                Text="{x:Static vm:SecretFieldViewModel.Mask}"
                                Visibility="{Binding Token.IsLocked, Converter={StaticResource BoolToVisibility}}" />
                            <Grid Margin="0,6,0,0" Visibility="{Binding Token.IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <TextBox
                                    x:Name="TokenEntryBox"
                                    AutomationProperties.Name="Novo token do bot"
                                    Style="{StaticResource IbtInput}"
                                    Text="{Binding Token.Entry, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource TokenPlaceholder}" Text="Cole o token aqui" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding Token.Hint}"
                                Visibility="{Binding Token.HasHint, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Margin="0,12,0,5" Style="{StaticResource FieldLabel}" Text="Chat ID do grupo" />
                            <Grid>
                                <TextBox
                                    x:Name="ChatBox"
                                    AutomationProperties.Name="Chat ID do grupo"
                                    IsEnabled="{Binding ChatIdEnabled}"
                                    Style="{StaticResource IbtInput}"
                                    Text="{Binding ChatIdText, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource ChatPlaceholder}" Text="-100..." />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding ChatIdHint}"
                                Visibility="{Binding HasChatIdHint, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Style="{StaticResource IbtCard}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Site" />
                                    <Border
                                        AutomationProperties.Name="Dicas"
                                        Style="{StaticResource SectionInfo}"
                                        ToolTip="Liga o PC ao site alertaibt.web.app: os avisos enviados pelo celular chegam aqui.&#10;Preencha com os dados que o script scripts\publicar-site.ps1 mostrou&#10;(estão em artifacts\credenciais-pc.txt) e ligue a chave.">
                                        <Path
                                            Width="15"
                                            Height="15"
                                            Data="{StaticResource LucideInfo}"
                                            Style="{StaticResource LucideIcon}" />
                                    </Border>
                                </StackPanel>
                                <ToggleButton
                                    x:Name="SiteSwitch"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="Site ligado"
                                    IsChecked="{Binding SiteEnabled, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </Grid>

                            <TextBlock Margin="0,10,0,5" Style="{StaticResource FieldLabel}" Text="URL do banco" />
                            <Grid>
                                <TextBox
                                    x:Name="SiteUrlBox"
                                    AutomationProperties.Name="URL do banco"
                                    LostFocus="OnFieldLostFocus"
                                    Style="{StaticResource IbtInput}"
                                    Tag="{Binding SiteUrl}"
                                    Text="{Binding SiteUrl.Text, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource SiteUrlPlaceholder}" Text="https://alertaibt-default-rtdb.firebaseio.com" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding SiteUrl.Hint}"
                                Visibility="{Binding SiteUrl.HasHint, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Margin="0,12,0,5" Style="{StaticResource FieldLabel}" Text="Chave da API (web)" />
                            <TextBox
                                x:Name="SiteApiKeyBox"
                                AutomationProperties.Name="Chave da API (web)"
                                LostFocus="OnFieldLostFocus"
                                Style="{StaticResource IbtInput}"
                                Tag="{Binding SiteApiKey}"
                                Text="{Binding SiteApiKey.Text, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding SiteApiKey.Hint}"
                                Visibility="{Binding SiteApiKey.HasHint, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Margin="0,12,0,5" Style="{StaticResource FieldLabel}" Text="E-mail do PC" />
                            <TextBox
                                x:Name="SiteEmailBox"
                                AutomationProperties.Name="E-mail do PC"
                                LostFocus="OnFieldLostFocus"
                                Style="{StaticResource IbtInput}"
                                Tag="{Binding SiteEmail}"
                                Text="{Binding SiteEmail.Text, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding SiteEmail.Hint}"
                                Visibility="{Binding SiteEmail.HasHint, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,12,0,0" MinHeight="22">
                                <TextBlock HorizontalAlignment="Left" Style="{StaticResource FieldLabel}" Text="Senha do PC" />
                                <Button
                                    x:Name="SitePasswordLockButton"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="{Binding SitePassword.LockButtonText}"
                                    Click="OnSitePasswordLockClick"
                                    Command="{Binding SitePassword.ToggleLockCommand}"
                                    Style="{StaticResource IbtLockButton}"
                                    Visibility="{Binding SitePassword.CanLock, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="14"
                                            Height="14"
                                            Data="{Binding SitePassword.LockIconKey, Converter={StaticResource GeometryKey}}"
                                            StrokeThickness="1.5"
                                            Style="{StaticResource LucideIcon}" />
                                        <TextBlock Margin="5,0,0,0" Text="{Binding SitePassword.LockButtonText}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox
                                x:Name="SitePasswordLockedBox"
                                Margin="0,6,0,0"
                                AutomationProperties.Name="Senha do PC (guardada)"
                                IsEnabled="False"
                                IsReadOnly="True"
                                Style="{StaticResource IbtInput}"
                                Text="{x:Static vm:SecretFieldViewModel.Mask}"
                                Visibility="{Binding SitePassword.IsLocked, Converter={StaticResource BoolToVisibility}}" />
                            <Grid Margin="0,6,0,0" Visibility="{Binding SitePassword.IsEditing, Converter={StaticResource BoolToVisibility}}">
                                <PasswordBox
                                    x:Name="SitePasswordBox"
                                    AutomationProperties.Name="Nova senha do PC"
                                    PasswordChanged="OnSitePasswordChanged"
                                    Style="{StaticResource IbtPasswordInput}" />
                                <TextBlock Style="{StaticResource SitePasswordPlaceholder}" Text="Cole a senha aqui" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding SitePassword.Hint}"
                                Visibility="{Binding SitePassword.HasHint, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: the live preview and the system, one card per section. -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource IbtCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Prévia no LED 2560x768" />
                            <Border
                                Margin="0,10,0,0"
                                BorderBrush="#14FFFFFF"
                                BorderThickness="1"
                                ClipToBounds="True"
                                CornerRadius="6">
                                <local:BarPreviewControl
                                    x:Name="Preview"
                                    Bar="{Binding PreviewBar}"
                                    SampleText="{Binding SampleText}" />
                            </Border>
                            <Button
                                x:Name="ShowBarButton"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Mostrar barra 3 s no LED"
                                Command="{Binding ShowBarCommand}"
                                Style="{StaticResource IbtButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideMonitor}"
                                        Style="{StaticResource LucideIcon}" />
                                    <TextBlock Margin="6,0,0,0" Text="Mostrar barra 3 s no LED" />
                                </StackPanel>
                            </Button>
                            <TextBlock
                                Style="{StaticResource IbtHint}"
                                Text="{Binding BarTestMessage}"
                                Visibility="{Binding HasBarTestMessage, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <!-- Sistema, in sections: each one a card with its title, one SettingRow per setting. -->
                    <local:SettingsSection
                        x:Name="MouseSection"
                        Header="Mouse"
                        Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="MouseLockRow"
                                Title="Travar o mouse na tela principal"
                                Info="Prende o cursor no monitor principal do Windows: ele não para mais no LED nem no retorno.&#10;Também liga e desliga pelo atalho abaixo e pelo ícone da bandeja."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="MouseLockSwitch"
                                    AutomationProperties.Name="Travar o mouse na tela principal"
                                    IsChecked="{Binding MouseLockEnabled, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="MouseLockHotkeyRow"
                                Title="Atalho para travar o mouse"
                                Info="Clique no campo e aperte a nova combinação.&#10;Precisa ter Ctrl, Alt ou Win."
                                Style="{StaticResource SettingRowStyle}">
                                <TextBox
                                    x:Name="MouseLockHotkeyBox"
                                    AutomationProperties.Name="Atalho para travar o mouse"
                                    Style="{StaticResource HotkeyInput}"
                                    PreviewKeyDown="OnMouseLockHotkeyKeyDown"
                                    Text="{Binding MouseLockHotkeyDisplay, Mode=OneWay}" />
                                <local:SettingRow.Footer>
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="MouseLockHotkeyHintLine"
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding MouseLockHotkeyHint}"
                                            Visibility="{Binding HasMouseLockHotkeyHint, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            x:Name="MouseLockHotkeyProblemLine"
                                            Style="{StaticResource IbtHint}"
                                            Text="{Binding MouseLockHotkeyProblem}"
                                            Visibility="{Binding HasMouseLockHotkeyProblem, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </local:SettingRow.Footer>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="TripleCtrlRow"
                                Title="Ctrl 3 vezes traz o mouse ao centro"
                                Info="Aperte Ctrl três vezes seguidas, rápido e sem outra tecla no meio: o mouse vai para o centro do monitor principal, onde quer que esteja.&#10;Funciona com o travamento ligado ou desligado. O app só conta os Ctrl; não guarda o que é digitado."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="TripleCtrlSwitch"
                                    AutomationProperties.Name="Ctrl 3 vezes traz o mouse ao centro"
                                    IsChecked="{Binding TripleCtrl, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>
                        </StackPanel>
                    </local:SettingsSection>

                    <local:SettingsSection
                        x:Name="QuickPanelSection"
                        Header="Painel rápido"
                        Style="{StaticResource SettingsSectionStyle}">
                        <local:SettingRow
                            x:Name="QuickPanelHotkeyRow"
                            Title="Atalho do painel rápido"
                            Info="Clique no campo e aperte a nova combinação.&#10;Precisa ter Ctrl, Alt ou Win."
                            Style="{StaticResource SettingRowStyle}">
                            <TextBox
                                x:Name="HotkeyBox"
                                AutomationProperties.Name="Atalho do painel rápido"
                                Style="{StaticResource HotkeyInput}"
                                PreviewKeyDown="OnHotkeyKeyDown"
                                Text="{Binding HotkeyDisplay, Mode=OneWay}" />
                            <local:SettingRow.Footer>
                                <StackPanel>
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding HotkeyHint}"
                                        Visibility="{Binding HasHotkeyHint, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding HotkeyProblem}"
                                        Visibility="{Binding HasHotkeyProblem, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </local:SettingRow.Footer>
                        </local:SettingRow>
                    </local:SettingsSection>

                    <local:SettingsSection
                        x:Name="HistorySection"
                        Header="Histórico"
                        Style="{StaticResource SettingsSectionStyle}">
                        <local:SettingRow
                            x:Name="ClearHistoryRow"
                            Title="Limpar histórico toda segunda-feira, 00:00"
                            Info="Apaga o histórico do PC e do site, e as mensagens do bot no Telegram com menos de 48 h.&#10;Se o PC estiver desligado nessa hora, a limpeza acontece quando ele ligar."
                            Style="{StaticResource SettingRowStyle}">
                            <ToggleButton
                                x:Name="ClearHistorySwitch"
                                AutomationProperties.Name="Limpar histórico toda segunda-feira"
                                IsChecked="{Binding ClearHistoryWeekly, Mode=TwoWay}"
                                Style="{StaticResource IbtSwitch}" />
                        </local:SettingRow>
                    </local:SettingsSection>
                </StackPanel>
            </Grid>

            <!-- Second row, under the tallest column above: the updates on the left, the system on the right. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <!-- The automatic update: the switch, the version with "Verificar agora", and how the last look ended. -->
                    <local:SettingsSection
                        x:Name="UpdatesSection"
                        Header="Atualizações"
                        Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="AutoUpdateRow"
                                Title="Atualizar automaticamente ao abrir"
                                Info="Procura uma versão nova ao abrir o app e a cada 30 minutos.&#10;Se achar, baixa e instala sozinho, reiniciando, mas só quando não há aviso na fila nem na barra e a pregação não está pausada."
                                Style="{StaticResource SettingRowStyle}">
                                <ToggleButton
                                    x:Name="AutoUpdateSwitch"
                                    AutomationProperties.Name="Atualizar automaticamente ao abrir"
                                    IsChecked="{Binding AutoUpdate, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="VersionRow"
                                Title="{Binding VersionText}"
                                Style="{StaticResource SettingRowStyle}">
                                <Button
                                    x:Name="CheckUpdateButton"
                                    AutomationProperties.Name="Verificar agora"
                                    Command="{Binding CheckUpdateCommand}"
                                    Style="{StaticResource IbtButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path
                                            Width="15"
                                            Height="15"
                                            Data="{StaticResource LucideRotateCcw}"
                                            Style="{StaticResource LucideIcon}" />
                                        <TextBlock Margin="6,0,0,0" Text="Verificar agora" />
                                    </StackPanel>
                                </Button>
                                <local:SettingRow.Footer>
                                    <TextBlock
                                        x:Name="UpdateResultLine"
                                        Style="{StaticResource IbtHint}"
                                        Text="{Binding UpdateResultText}" />
                                </local:SettingRow.Footer>
                            </local:SettingRow>
                        </StackPanel>
                    </local:SettingsSection>
                </StackPanel>
                <StackPanel Grid.Column="2">

                    <local:SettingsSection
                        x:Name="SystemSection"
                        Header="Sistema"
                        Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel>
                            <local:SettingRow
                                x:Name="HideFromLiveRow"
                                Title="Esconder da live (OBS e NDI)"
                                Style="{StaticResource SettingRowStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        Data="{StaticResource LucideLock}"
                                        Style="{StaticResource LucideIcon}"
                                        TextElement.Foreground="{StaticResource IbtOkBrush}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource IbtOkBrush}"
                                        Text="sempre ligado" />
                                </StackPanel>
                            </local:SettingRow>

                            <local:SettingRow
                                x:Name="SiteStatusRow"
                                Title="Conexão com o site"
                                Style="{StaticResource SettingRowStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <Border
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding SiteLight, Converter={StaticResource StatusLightBrush}}"
                                        CornerRadius="4" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource IbtMutedBrush}"
                                        Text="{Binding SiteText}" />
                                </StackPanel>
                            </local:SettingRow>
                        </StackPanel>
                    </local:SettingsSection>
                </StackPanel>
            </Grid>

            <!-- Diagnóstico: folded away; the logs live here. -->
            <Border Margin="0,12,0,0" Style="{StaticResource IbtCard}">
                <Expander
                    x:Name="DiagnosticsExpander"
                    DataContext="{Binding Diagnostics}"
                    IsExpanded="{Binding IsOpen, Mode=TwoWay}"
                    Style="{StaticResource IbtExpander}">
                    <Expander.Header>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    Data="{StaticResource LucideScrollText}"
                                    Style="{StaticResource LucideIcon}"
                                    TextElement.Foreground="{StaticResource IbtTextBrush}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13.5"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource IbtTextBrush}"
                                    Text="Diagnóstico" />
                            </StackPanel>
                            <TextBlock
                                x:Name="DiagnosticsMeta"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{StaticResource IbtMutedBrush}"
                                Text="{Binding Meta}" />
                        </Grid>
                    </Expander.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Copiar logs"
                                Command="{Binding CopyCommand}"
                                Style="{StaticResource IbtButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideCopy}"
                                        Style="{StaticResource LucideIcon}" />
                                    <TextBlock Margin="6,0,0,0" Text="Copiar logs" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Exportar logs"
                                Command="{Binding ExportCommand}"
                                Style="{StaticResource IbtButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideDownload}"
                                        Style="{StaticResource LucideIcon}" />
                                    <TextBlock Margin="6,0,0,0" Text="Exportar" />
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Limpar logs"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource IbtDangerButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideTrash2}"
                                        Style="{StaticResource LucideIcon}" />
                                    <TextBlock Margin="6,0,0,0" Text="Limpar" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource IbtMutedBrush}"
                            Text="{Binding Message}"
                            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                        <Border
                            Margin="0,10,0,0"
                            Padding="10"
                            Background="#060607"
                            BorderBrush="{StaticResource IbtLineBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="LogList" ItemsSource="{Binding Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{Binding Severity, Converter={StaticResource LogSeverityBrush}}"
                                                LineHeight="18"
                                                Text="{Binding Text}"
                                                TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Expander>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
