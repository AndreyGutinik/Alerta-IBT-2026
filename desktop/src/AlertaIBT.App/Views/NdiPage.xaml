<UserControl
    x:Class="AlertaIBT.App.Views.NdiPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views"
    xmlns:theme="clr-namespace:AlertaIBT.App.Theme"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels">

    <!--
        The NDI tab, top to bottom: (1) Previa and No ar side by side with the Cortar button between them, (2) the camera buttons, (3) the telao card and
        the settings card, (4) the NDI trademark line. Same language as the Som tab: lighter cards with a thin border, icons with tooltips, an 8 px grid.
    -->

    <UserControl.Resources>
        <!-- A small label on top of a picture (Previa, No ar): dark glass, one short word. -->
        <Style x:Key="NdiPill" TargetType="Border">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#CC0A0A0C" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource IbtTextBrush}" />
        </Style>

        <!-- The status chips of the telao card: a 32 px capsule with an icon and a number. -->
        <Style x:Key="NdiChip" TargetType="Border">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource IbtInsetBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource IbtBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource IbtTextSecondaryBrush}" />
        </Style>

        <Style x:Key="NdiChipIcon" BasedOn="{StaticResource LucideIcon}" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A link in words (ndi.video): the text of a button, underlined when hovered. -->
        <Style x:Key="NdiLink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource IbtInfoBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                            <TextBlock
                                x:Name="Label"
                                FontSize="12.5"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}" />
                            <Path
                                Width="12"
                                Height="12"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource LucideExternalLink}"
                                Style="{StaticResource LucideIcon}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big round-rectangle Cortar button between the two pictures. -->
        <Style x:Key="NdiTakeButton" TargetType="Button">
            <Setter Property="Width" Value="104" />
            <Setter Property="Height" Value="80" />
            <Setter Property="Foreground" Value="#04130B" />
            <Setter Property="Background" Value="{StaticResource IbtAccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                CornerRadius="20" />
                            <Border
                                x:Name="Ring"
                                BorderBrush="{StaticResource IbtFocusRingBrush}"
                                BorderThickness="2"
                                CornerRadius="20"
                                Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    Data="{StaticResource LucideScissors}"
                                    Style="{StaticResource LucideIcon}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="Cortar" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#27C277" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Background" Value="{StaticResource IbtSurfaceRaisedBrush}" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource IbtBorderBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A camera button: a block with the name; a green border while it is in the Previa, a red one while it is No ar. -->
        <Style x:Key="NdiCameraButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource IbtSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource IbtBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource IbtBlockRadius}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border
                                x:Name="Wash"
                                Background="{StaticResource IbtHoverOverlayBrush}"
                                CornerRadius="{StaticResource IbtBlockRadius}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="Ring"
                                BorderBrush="{StaticResource IbtFocusRingBrush}"
                                BorderThickness="2"
                                CornerRadius="{StaticResource IbtBlockRadius}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Wash" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPreview}" Value="True">
                    <Setter Property="Background" Value="#14292A" />
                    <Setter Property="BorderBrush" Value="#1DA35F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsProgram}" Value="True">
                    <Setter Property="Background" Value="#2A1618" />
                    <Setter Property="BorderBrush" Value="#E5484D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NdiSmallTool" BasedOn="{StaticResource IbtToolButton}" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="NdiSmallDangerTool" BasedOn="{StaticResource IbtDangerToolButton}" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- One of the two big pictures with its vertical-position slider under it. -->
        <DataTemplate x:Key="LaneTemplate" DataType="{x:Type vm:NdiLaneViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="Stage">
                    <local:NdiThumbnailView
                        x:Name="Picture"
                        AutomationProperties.Name="{Binding Description}"
                        Lane="{Binding}"
                        ToolTip="Gire o mouse sobre a imagem para mover a faixa do telão (Shift = 5%)." />

                    <!-- Previa / No ar (the tally of the lane that is on air: red while it is on the telao, green while it is only chosen). -->
                    <Border
                        x:Name="Pill"
                        Margin="8,8,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Style="{StaticResource NdiPill}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                x:Name="PillIcon"
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource LucideEye}"
                                Style="{StaticResource LucideIcon}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Text="{Binding PillText}" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="NameChip"
                        MaxWidth="180"
                        Margin="8,0,0,8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource NdiPill}"
                        Visibility="{Binding HasCamera, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            FontSize="12"
                            Text="{Binding CameraName}"
                            TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="24"
                        Height="24"
                        Margin="0,0,8,0"
                        Background="Transparent"
                        ToolTip="{Binding SliderTip}">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource LucideMoveVertical}"
                            Style="{StaticResource IbtRowIcon}" />
                    </Border>
                    <Slider
                        x:Name="PositionSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding Title, StringFormat='Posição vertical: {0}'}"
                        IsEnabled="{Binding HasCamera}"
                        IsMoveToPointEnabled="True"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="1"
                        Style="{StaticResource IbtSeekSlider}"
                        TickFrequency="1"
                        ToolTip="{Binding SliderTip}"
                        Value="{Binding Position, Mode=TwoWay}" />
                    <TextBlock
                        x:Name="PositionText"
                        Grid.Column="2"
                        Width="44"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IbtTextBrush}"
                        Text="{Binding Position, StringFormat='{}{0}%'}"
                        TextAlignment="Right" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsProgram}" Value="True">
                    <Setter TargetName="PillIcon" Property="Data" Value="{StaticResource LucideRadio}" />
                    <Setter TargetName="Pill" Property="ToolTip" Value="{Binding TallyTip}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsProgram}" Value="True" />
                        <Condition Binding="{Binding HasCamera}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Pill" Property="Background" Value="#1DA35F" />
                    <Setter TargetName="Pill" Property="BorderBrush" Value="#4FD88E" />
                    <Setter TargetName="Pill" Property="TextElement.Foreground" Value="#04130B" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsProgram}" Value="True" />
                        <Condition Binding="{Binding TallyRed}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Pill" Property="Background" Value="#E5484D" />
                    <Setter TargetName="Pill" Property="BorderBrush" Value="#FF8A8E" />
                    <Setter TargetName="Pill" Property="TextElement.Foreground" Value="#FFFFFF" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NdiCameraItem}">
            <Grid x:Name="Tile" Height="80">
                <Button
                    x:Name="Select"
                    AutomationProperties.Name="{Binding Name, StringFormat='Câmera {0}: mandar para a prévia'}"
                    Command="{Binding SelectCommand}"
                    Style="{StaticResource NdiCameraButton}"
                    ToolTip="{Binding Tip}">
                    <TextBlock
                        VerticalAlignment="Top"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                </Button>
                <Grid
                    Margin="12,0,8,8"
                    VerticalAlignment="Bottom">
                    <StackPanel
                        HorizontalAlignment="Left"
                        IsHitTestVisible="False"
                        Orientation="Horizontal">
                        <Border
                            x:Name="PreviewMark"
                            Padding="6,2"
                            Background="#261DA35F"
                            BorderBrush="#661DA35F"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding IsPreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="{StaticResource IbtOkBrush}">
                                <Path
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource LucideEye}"
                                    Style="{StaticResource LucideIcon}" />
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="Prévia" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="ProgramMark"
                            Padding="6,2"
                            Background="#33E5484D"
                            BorderBrush="#99E5484D"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding IsProgram, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" TextElement.Foreground="#FF9D9D">
                                <Path
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource LucideRadio}"
                                    Style="{StaticResource LucideIcon}" />
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="No ar" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="Edit"
                            AutomationProperties.Name="{Binding Name, StringFormat='Editar {0}'}"
                            Command="{Binding EditCommand}"
                            Style="{StaticResource NdiSmallTool}"
                            ToolTip="Nome e fonte da câmera">
                            <Path
                                Width="14"
                                Height="14"
                                Data="{StaticResource LucidePencil}"
                                Style="{StaticResource LucideIcon}" />
                        </Button>
                        <Button
                            x:Name="Delete"
                            Margin="4,0,0,0"
                            AutomationProperties.Name="{Binding Name, StringFormat='Remover {0}'}"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource NdiSmallDangerTool}"
                            ToolTip="Remover esta câmera">
                            <Path
                                Width="14"
                                Height="14"
                                Data="{StaticResource LucideTrash2}"
                                Style="{StaticResource LucideIcon}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NdiAddTile}">
            <Button
                x:Name="AddTile"
                Height="80"
                MinHeight="80"
                AutomationProperties.Name="Adicionar câmera"
                Command="{Binding Command}"
                Style="{StaticResource IbtAddTile}"
                ToolTip="Adicionar câmera">
                <Path
                    Width="20"
                    Height="20"
                    Data="{StaticResource LucidePlus}"
                    Style="{StaticResource LucideIcon}" />
            </Button>
        </DataTemplate>


    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1280"
            Margin="24">
            <TextBlock
                Margin="0,0,0,24"
                Style="{StaticResource IbtPageTitle}"
                Text="NDI" />

            <!-- The runtime is missing: one clear card at the top; the rest stays visible but off. -->
            <Border
                x:Name="RuntimeBanner"
                Margin="0,0,0,16"
                Background="{StaticResource IbtSurfaceBrush}"
                BorderBrush="#66FFD87A"
                BorderThickness="1"
                CornerRadius="{StaticResource IbtCardRadius}"
                Padding="20,16"
                Visibility="{Binding RuntimeMissing, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path
                        Width="24"
                        Height="24"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Data="{StaticResource LucideTriangleAlert}"
                        Style="{StaticResource LucideIcon}"
                        TextElement.Foreground="{StaticResource IbtWarnBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource IbtTextBrush}"
                            Text="NDI Tools não encontrado" />
                        <TextBlock
                            Margin="0,4,0,8"
                            Style="{StaticResource IbtSecondaryText}"
                            Text="Instale o NDI Tools (gratuito) neste PC e clique em verificar de novo."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="DownloadLink"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Abrir a página de download do NDI Tools"
                            Command="{Binding OpenDownloadCommand}"
                            Content="https://ndi.video/tools/"
                            Style="{StaticResource NdiLink}"
                            ToolTip="Abrir a página de download do NDI Tools" />
                    </StackPanel>
                    <Button
                        x:Name="RecheckButton"
                        Grid.Column="2"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Verificar de novo"
                        Command="{Binding RecheckCommand}"
                        Style="{StaticResource IbtToolButton}"
                        ToolTip="Verificar de novo">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource LucideRefreshCw}"
                            Style="{StaticResource LucideIcon}" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel x:Name="Body" IsEnabled="{Binding RuntimeOk}">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RuntimeOk}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- ===== (1) The Telao bar: one line, title left, status chips in the middle, the on/off switch right ===== -->
                <Border
                    x:Name="TelaoBar"
                    Padding="16,0"
                    Style="{StaticResource IbtSurfaceCard}">
                    <Grid MinHeight="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            x:Name="TelaoTitle"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            ToolTip="A câmera aparece no LED, por baixo do Holyrics e da barra de avisos. Ao abrir o app ela está sempre desligada.">
                            <Path
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource LucideMonitorPlay}"
                                Style="{StaticResource IbtRowIcon}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource IbtTextBrush}"
                                Text="Telão" />
                        </StackPanel>
                        <StackPanel
                            x:Name="TelaoChips"
                            Grid.Column="1"
                            Margin="16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                                <Border
                                x:Name="SignalChip"
                                AutomationProperties.Name="Sinal"
                                Margin="0,0,8,0"
                                Style="{StaticResource NdiChip}"
                                ToolTip="{Binding SignalTip}">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="SignalDot"
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SignalText}" />
                                </StackPanel>
                                <Border.Resources>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#6F6A63" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Signal}" Value="Live">
                                                <Setter Property="Fill" Value="#4FD88E" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Signal}" Value="Frozen">
                                                <Setter Property="Fill" Value="#FFD87A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Signal}" Value="NoSignal">
                                                <Setter Property="Fill" Value="#FF5C5C" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Signal}" Value="NoCamera">
                                                <Setter Property="Fill" Value="#FFD87A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Resources>
                            </Border>
                            <Border
                                x:Name="FpsChip"
                                AutomationProperties.Name="Quadros por segundo"
                                Margin="0,0,8,0"
                                Style="{StaticResource NdiChip}"
                                ToolTip="Quadros por segundo da câmera que está no ar">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path Data="{StaticResource LucideGauge}" Style="{StaticResource NdiChipIcon}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding FpsText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="ResolutionChip"
                                AutomationProperties.Name="Resolução da fonte"
                                Margin="0,0,8,0"
                                Style="{StaticResource NdiChip}"
                                ToolTip="Resolução da imagem que chega da câmera">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path Data="{StaticResource LucideMonitor}" Style="{StaticResource NdiChipIcon}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding ResolutionText}" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="DroppedChip"
                                AutomationProperties.Name="Quadros perdidos"
                                Margin="0,0,8,0"
                                Style="{StaticResource NdiChip}"
                                ToolTip="Quadros perdidos pela câmera que está no ar (o app não deu conta ou a rede falhou)">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path Data="{StaticResource LucideTriangleAlert}" Style="{StaticResource NdiChipIcon}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding DroppedText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ToggleButton
                            x:Name="LayerSwitch"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Câmera no telão"
                            IsChecked="{Binding LayerOn, Mode=TwoWay}"
                            Style="{StaticResource IbtSwitch}"
                            ToolTip="Câmera no telão: liga e desliga a câmera no LED. Sempre começa desligada quando o app abre.">
                            <ToggleButton.LayoutTransform>
                                <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                            </ToggleButton.LayoutTransform>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- ===== (2) Previa | Cortar | No ar ===== -->
                <Border
                    x:Name="Stage"
                    Margin="0,16,0,0"
                    Padding="16"
                    Style="{StaticResource IbtSurfaceCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="PreviewLane"
                            Content="{Binding Preview}"
                            ContentTemplate="{StaticResource LaneTemplate}"
                            Focusable="False" />
                        <Button
                            x:Name="TakeButton"
                            Grid.Column="1"
                            Margin="16,0,16,36"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Cortar"
                            Command="{Binding TakeCommand}"
                            IsEnabled="{Binding CanTake}"
                            Style="{StaticResource NdiTakeButton}"
                            ToolTip="Cortar: manda a prévia para o ar e a câmera que estava no ar volta para a prévia. Atalho: Ctrl+Espaço." />
                        <ContentControl
                            x:Name="OnAirLane"
                            Grid.Column="2"
                            Content="{Binding OnAir}"
                            ContentTemplate="{StaticResource LaneTemplate}"
                            Focusable="False" />
                    </Grid>
                </Border>

                <!-- A message from the engine (a Cortar that waited too long, a camera without a source...). -->
                <Border
                    x:Name="NoticeBar"
                    Margin="0,16,0,0"
                    Padding="16,10"
                    Background="{StaticResource IbtSurfaceRaisedBrush}"
                    BorderBrush="#66FFD87A"
                    BorderThickness="1"
                    CornerRadius="{StaticResource IbtBlockRadius}"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Width="16"
                            Height="16"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource LucideCircleAlert}"
                            Style="{StaticResource LucideIcon}"
                            TextElement.Foreground="{StaticResource IbtWarnBrush}" />
                        <TextBlock
                            x:Name="NoticeText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource IbtTextBrush}"
                            Text="{Binding Notice}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="DismissNotice"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Fechar a mensagem"
                            Command="{Binding DismissNoticeCommand}"
                            Style="{StaticResource NdiSmallTool}"
                            ToolTip="Fechar a mensagem">
                            <Path
                                Width="14"
                                Height="14"
                                Data="{StaticResource LucideX}"
                                Style="{StaticResource LucideIcon}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== (3) The cameras ===== -->
                <local:CardSection
                    x:Name="CamerasCard"
                    Margin="0,16,0,0"
                    Header="Câmeras"
                    Icon="{StaticResource LucideVideo}"
                    Info="Até 6 câmeras com o nome que você quiser. Clicar numa câmera manda ela para a Prévia; ela só vai ao ar com o botão Cortar (Ctrl+Espaço). F1 a F4 também escolhem as câmeras 1 a 4."
                    Style="{StaticResource IbtCardSectionStyle}">
                    <local:CardSection.HeaderActions>
                        <StackPanel Orientation="Horizontal">
                            <Border
                                x:Name="SourcesChip"
                                Margin="0,0,8,0"
                                Style="{StaticResource NdiChip}"
                                ToolTip="{Binding SourceCount, StringFormat='Fontes NDI encontradas na rede: {0}'}"
                                AutomationProperties.Name="Fontes NDI encontradas">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Path Data="{StaticResource LucideRadio}" Style="{StaticResource NdiChipIcon}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding SourceCount}" />
                                </StackPanel>
                            </Border>
                            <Button
                                x:Name="IpsButton"
                                AutomationProperties.Name="IPs fixos"
                                Command="{Binding ManageIpsCommand}"
                                Style="{StaticResource IbtToolButton}"
                                ToolTip="IPs fixos: procurar câmeras em outro endereço da rede">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource LucideNetwork}"
                                    Style="{StaticResource LucideIcon}" />
                            </Button>
                        </StackPanel>
                    </local:CardSection.HeaderActions>
                    <Grid>
                        <!-- Nothing added yet: one friendly tile. -->
                        <Button
                            x:Name="EmptyTile"
                            MinHeight="136"
                            AutomationProperties.Name="Adicionar a primeira câmera"
                            Command="{Binding AddCameraCommand}"
                            Style="{StaticResource IbtAddTile}"
                            ToolTip="Adicionar câmera"
                            Visibility="{Binding HasNoCameras, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Path
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    Data="{StaticResource LucideVideo}"
                                    Style="{StaticResource LucideIcon}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource IbtTextBrush}"
                                    Text="Adicione sua primeira câmera" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource IbtSecondaryText}"
                                    Text="Escolha uma fonte NDI da lista ou digite o IP." />
                                <TextBlock
                                    x:Name="NoSourcesText"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Text="Nenhuma fonte NDI encontrada ainda.">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource IbtSecondaryText}" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SourceCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <ItemsControl
                            x:Name="CameraGrid"
                            Focusable="False"
                                            ItemsSource="{Binding Tiles}"
                            Visibility="{Binding HasCameras, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <theme:AdaptiveGrid
                                        Gap="16"
                                        MaxColumns="4"
                                        MinColumnWidth="176" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </local:CardSection>

                <!-- ===== (4) Settings: one full-width card, one column ===== -->
            <local:CardSection
                x:Name="SettingsCard"
                Margin="0,16,0,0"
                Header="Ajustes"
                Icon="{StaticResource LucideSlidersHorizontal}"
                Style="{StaticResource IbtCardSectionStyle}">
                <StackPanel>
                    <Border Style="{StaticResource IbtBlock}">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path
                                Margin="0,0,12,0"
                                Data="{StaticResource LucideMonitor}"
                                Style="{StaticResource IbtRowIcon}"
                                ToolTip="Monitor onde a câmera aparece" />
                            <ComboBox
                                x:Name="MonitorCombo"
                                Grid.Column="1"
                                AutomationProperties.Name="Monitor da câmera"
                                DisplayMemberPath="Display"
                                IsEnabled="{Binding MonitorUnlocked}"
                                ItemsSource="{Binding Monitors}"
                                SelectedValue="{Binding SelectedMonitor, Mode=TwoWay}"
                                SelectedValuePath="DeviceName"
                                Style="{StaticResource IbtComboBox}" />
                            <ToggleButton
                                x:Name="MonitorLock"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Travar no monitor do LED"
                                IsChecked="{Binding MonitorLocked, Mode=TwoWay}"
                                Style="{StaticResource IbtLockToggle}"
                                ToolTip="Travado: a câmera vai para o monitor do LED (2560 x 768). Destravar deixa escolher outro monitor." />
                        </Grid>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource IbtBlock}">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path
                                Margin="0,0,12,0"
                                Data="{StaticResource IbtTestBars}"
                                Style="{StaticResource IbtRowIcon}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource IbtRowLabel}"
                                Text="Barras de teste"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="Mostra barras de cores sobre todo o LED, mesmo com a câmera desligada. Serve para conferir se a letra do Holyrics e a barra de avisos ficam por cima." />
                            <ToggleButton
                                x:Name="TestPatternSwitch"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Barras de teste"
                                IsChecked="{Binding TestPattern, Mode=TwoWay}"
                                Style="{StaticResource IbtSwitch}"
                                ToolTip="Mostra barras de cores sobre todo o LED, mesmo com a câmera desligada. Serve para conferir se a letra do Holyrics e a barra de avisos ficam por cima." />
                        </Grid>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource IbtBlock}">
                        <Grid MinHeight="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path
                                Margin="0,0,12,0"
                                Data="{StaticResource LucideEyeOff}"
                                Style="{StaticResource IbtRowIcon}" />
                            <TextBlock
                                Grid.Column="1"
                                Style="{StaticResource IbtRowLabel}"
                                Text="Esconder da live (OBS/NDI)"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="Ligado: a câmera some das capturas de tela, então o OBS e o NDI da live não a veem (só o LED mostra). Desligado: o OBS pode capturar o telão com a câmera." />
                            <ToggleButton
                                x:Name="HideSwitch"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Esconder da live"
                                IsChecked="{Binding HideFromCapture, Mode=TwoWay}"
                                Style="{StaticResource IbtSwitch}"
                                ToolTip="Ligado: a câmera some das capturas de tela, então o OBS e o NDI da live não a veem (só o LED mostra). Desligado: o OBS pode capturar o telão com a câmera." />
                        </Grid>
                    </Border>

                    <Border Margin="0,8,0,0" Style="{StaticResource IbtBlock}">
                        <StackPanel>
                            <Grid MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    Margin="0,0,12,0"
                                    Data="{StaticResource LucideKeyboard}"
                                    Style="{StaticResource IbtRowIcon}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource IbtRowLabel}"
                                    Text="Atalhos F1-F4 e Ctrl+Espaço"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="F1 a F4 mandam as câmeras 1 a 4 para a Prévia e Ctrl+Espaço corta. Atenção: F1 a F4 sozinhas valem em qualquer programa enquanto isto estiver ligado e podem bater com atalhos do Holyrics. Desligue se atrapalhar." />
                                <ToggleButton
                                    x:Name="ShortcutsSwitch"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Atalhos F1 a F4 e Ctrl+Espaço"
                                    IsChecked="{Binding ShortcutsEnabled, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}"
                                    ToolTip="F1 a F4 mandam as câmeras 1 a 4 para a Prévia e Ctrl+Espaço corta. Atenção: F1 a F4 sozinhas valem em qualquer programa enquanto isto estiver ligado e podem bater com atalhos do Holyrics. Desligue se atrapalhar." />
                            </Grid>
                            <StackPanel
                                x:Name="ShortcutWarning"
                                Margin="0,12,0,0"
                                Orientation="Horizontal"
                                Visibility="{Binding HasShortcutWarning, Converter={StaticResource BoolToVisibility}}">
                                <Path
                                    Width="16"
                                    Height="16"
                                    Margin="0,1,10,0"
                                    VerticalAlignment="Top"
                                    Data="{StaticResource LucideTriangleAlert}"
                                    Style="{StaticResource LucideIcon}"
                                    TextElement.Foreground="{StaticResource IbtWarnBrush}" />
                                <TextBlock
                                    x:Name="ShortcutWarningText"
                                    MaxWidth="360"
                                    Foreground="{StaticResource IbtWarnBrush}"
                                    Text="{Binding ShortcutWarning}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </local:CardSection>
            </StackPanel>

            <!-- ===== (4) The line NDI asks for ===== -->
            <StackPanel
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    x:Name="TrademarkText"
                    VerticalAlignment="Center"
                    Style="{StaticResource IbtSecondaryText}"
                    Text="{Binding TrademarkText}" />
                <Button
                    x:Name="SiteLink"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Abrir ndi.video"
                    Command="{Binding OpenSiteCommand}"
                    Content="ndi.video"
                    Style="{StaticResource NdiLink}"
                    ToolTip="Abrir ndi.video" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
