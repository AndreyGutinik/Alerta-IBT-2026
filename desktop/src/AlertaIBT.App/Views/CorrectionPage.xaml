<UserControl
    x:Class="AlertaIBT.App.Views.CorrectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels">

    <UserControl.Resources>
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="11,10,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style
            x:Key="RulesPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=RulesBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="KeyPlaceholder"
            BasedOn="{StaticResource Placeholder}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="11,9,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=KeyEntryBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RulesNoteText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RulesNoteIsWarning}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource IbtWarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- Header: the title, the Gemini state, and the stamp that says everything is saved. -->
            <Grid Margin="0,0,0,12">
                <TextBlock Style="{StaticResource IbtTitle}" Text="Correção" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Border
                        x:Name="GeminiPill"
                        Margin="0,0,8,0"
                        Padding="9,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Gemini"
                        Background="{StaticResource IbtPanelStrongBrush}"
                        BorderBrush="{StaticResource IbtLineBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        ToolTip="{Binding GeminiTip}">
                        <StackPanel Orientation="Horizontal">
                            <Border
                                Width="8"
                                Height="8"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Background="{Binding GeminiLight, Converter={StaticResource StatusLightBrush}}"
                                CornerRadius="4" />
                            <TextBlock FontSize="11.5" Text="{Binding GeminiText, StringFormat=Gemini · {0}}" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="SavedBadge" Style="{StaticResource IbtSavedBadge}">
                        <TextBlock FontSize="12" Text="{Binding Saver.Label}" />
                    </Border>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="620" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                <Border Style="{StaticResource IbtCard}">
                    <StackPanel>
                        <Grid MinHeight="22">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource IbtCaption}"
                                Text="CORREÇÃO AUTOMÁTICA" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Border
                                    AutomationProperties.Name="Dicas"
                                    Style="{StaticResource IbtInfoIcon}"
                                    ToolTipService.InitialShowDelay="150"
                                    ToolTipService.ShowDuration="30000"
                                    ToolTip="Corrige o português e organiza no padrão:&#10;MODELO COR | PLACA: ABC-1234 | MOTIVO&#10;Aceita placa antiga e Mercosul.&#10;Sem modelo, cor ou placa: não vai para o telão&#10;e volta uma mensagem de erro. Sem motivo: passa.&#10;Gemini: grátis, precisa de internet.&#10;Só offline: nada sai do PC.&#10;Sem internet, cai sozinho no offline.">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideInfo}"
                                        Style="{StaticResource LucideIcon}" />
                                </Border>
                                <ToggleButton
                                    x:Name="EnabledSwitch"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Correção automática"
                                    IsChecked="{Binding Enabled, Mode=TwoWay}"
                                    Style="{StaticResource IbtSwitch}" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="ModeCards" Margin="0,8,0,0" IsEnabled="{Binding Enabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="GeminiOption"
                                AutomationProperties.Name="Gemini"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="gemini"
                                Style="{StaticResource IbtOptionCard}"
                                Tag="{Binding UseGemini}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideSparkles}"
                                        Style="{StaticResource LucideIcon}"
                                        TextElement.Foreground="{StaticResource IbtAccentGlowBrush}" />
                                    <TextBlock Margin="7,0,0,0" Text="Gemini" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="OfflineOption"
                                Grid.Column="2"
                                AutomationProperties.Name="Só offline"
                                Command="{Binding SelectModeCommand}"
                                CommandParameter="offline"
                                Style="{StaticResource IbtOptionCard}"
                                Tag="{Binding UseOffline}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideWifiOff}"
                                        Style="{StaticResource LucideIcon}"
                                        TextElement.Foreground="{StaticResource IbtAccentGlowBrush}" />
                                    <TextBlock Margin="7,0,0,0" Text="Só offline" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- The Gemini key: dots when stored, "Trocar" opens an empty box for a new one. -->
                        <Grid Margin="0,12,0,0" MinHeight="22">
                            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{StaticResource IbtMutedBrush}"
                                    Text="Chave do Gemini (grátis)" />
                                <Border
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Dicas"
                                    Style="{StaticResource IbtInfoIcon}"
                                    ToolTipService.InitialShowDelay="150"
                                    ToolTipService.ShowDuration="30000"
                                    ToolTip="Crie grátis em aistudio.google.com.&#10;Sem cartão de crédito.&#10;Fica guardada criptografada neste PC.">
                                    <Path
                                        Width="15"
                                        Height="15"
                                        Data="{StaticResource LucideInfo}"
                                        Style="{StaticResource LucideIcon}" />
                                </Border>
                            </StackPanel>
                            <Button
                                x:Name="KeyLockButton"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{Binding GeminiKey.LockButtonText}"
                                Click="OnKeyLockClick"
                                Command="{Binding GeminiKey.ToggleLockCommand}"
                                Style="{StaticResource IbtLockButton}"
                                Visibility="{Binding GeminiKey.CanLock, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path
                                        Width="14"
                                        Height="14"
                                        Data="{Binding GeminiKey.LockIconKey, Converter={StaticResource GeometryKey}}"
                                        StrokeThickness="1.5"
                                        Style="{StaticResource LucideIcon}" />
                                    <TextBlock Margin="5,0,0,0" Text="{Binding GeminiKey.LockButtonText}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBox
                            x:Name="KeyLockedBox"
                            Margin="0,6,0,0"
                            AutomationProperties.Name="Chave do Gemini (guardada)"
                            IsEnabled="False"
                            IsReadOnly="True"
                            Style="{StaticResource IbtInput}"
                            Text="{x:Static vm:SecretFieldViewModel.Mask}"
                            Visibility="{Binding GeminiKey.IsLocked, Converter={StaticResource BoolToVisibility}}" />
                        <Grid Margin="0,6,0,0" Visibility="{Binding GeminiKey.IsEditing, Converter={StaticResource BoolToVisibility}}">
                            <TextBox
                                x:Name="KeyEntryBox"
                                AutomationProperties.Name="Nova chave do Gemini"
                                Style="{StaticResource IbtInput}"
                                Text="{Binding GeminiKey.Entry, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource KeyPlaceholder}" Text="Cole a chave aqui" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource IbtHint}"
                            Text="{Binding GeminiKey.Hint}"
                            Visibility="{Binding GeminiKey.HasHint, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Avançado: the model. -->
                        <Expander
                            x:Name="AdvancedExpander"
                            Margin="0,12,0,0"
                            Style="{StaticResource IbtExpander}">
                            <Expander.Header>
                                <TextBlock Text="Avançado" />
                            </Expander.Header>
                            <StackPanel>
                                <Grid MinHeight="22">
                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11.5"
                                            Foreground="{StaticResource IbtMutedBrush}"
                                            Text="Modelo do Gemini" />
                                        <Border
                                            Margin="6,0,0,0"
                                            AutomationProperties.Name="Dicas"
                                            Style="{StaticResource IbtInfoIcon}"
                                            ToolTipService.InitialShowDelay="150"
                                            ToolTipService.ShowDuration="30000"
                                            ToolTip="Deixe o padrão, a menos que o Google tire&#10;esse modelo do plano grátis.&#10;Em branco, vale o padrão.">
                                            <Path
                                                Width="15"
                                                Height="15"
                                                Data="{StaticResource LucideInfo}"
                                                Style="{StaticResource LucideIcon}" />
                                        </Border>
                                    </StackPanel>
                                    <Button
                                        x:Name="ResetModelButton"
                                        HorizontalAlignment="Right"
                                        Command="{Binding ResetModelCommand}"
                                        Style="{StaticResource IbtLockButton}"
                                        ToolTip="Voltar ao modelo padrão">
                                        <TextBlock Text="Padrão" />
                                    </Button>
                                </Grid>
                                <TextBox
                                    x:Name="ModelBox"
                                    Margin="0,6,0,0"
                                    AutomationProperties.Name="Modelo do Gemini"
                                    Style="{StaticResource IbtInput}"
                                    Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Style="{StaticResource IbtHint}"
                                    Text="{Binding ModelHint}"
                                    Visibility="{Binding HasModelHint, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0" Style="{StaticResource IbtCard}">
                    <StackPanel>
                        <Grid MinHeight="22">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Style="{StaticResource IbtCaption}"
                                Text="REGRAS FIXAS" />
                            <Border
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="Dicas"
                                Style="{StaticResource IbtInfoIcon}"
                                ToolTipService.InitialShowDelay="150"
                                ToolTipService.ShowDuration="30000"
                                ToolTip="Opcional. Uma por linha:&#10;texto errado => texto certo">
                                <Path
                                    Width="15"
                                    Height="15"
                                    Data="{StaticResource LucideInfo}"
                                    Style="{StaticResource LucideIcon}" />
                            </Border>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <TextBox
                                x:Name="RulesBox"
                                MinLines="6"
                                MaxLines="14"
                                AcceptsReturn="True"
                                AutomationProperties.Name="Regras fixas"
                                Style="{StaticResource IbtInput}"
                                Text="{Binding RulesText, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="NoWrap" />
                            <TextBlock Style="{StaticResource RulesPlaceholder}" Text="farol acesso => farol aceso" />
                        </Grid>
                        <TextBlock
                            x:Name="RulesNote"
                            Style="{StaticResource RulesNoteText}"
                            Text="{Binding RulesNote}"
                            Visibility="{Binding HasRulesNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
