<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:theme="clr-namespace:AlertaIBT.App.Theme">

    <!--
        Shared control styles of the IBT Controller windows (painel-v7.html: .btn, .btn.pri, .btn.urg, textarea, .info, tooltips).
        Needs AppTheme.xaml (brushes, MarbleFont) and LucideIcons.xaml, merged before this file.
    -->

    <theme:StatusLightBrushConverter x:Key="StatusLightBrush" />
    <theme:PreviewToneBrushConverter x:Key="PreviewToneBrush" />
    <theme:FeedbackToneBrushConverter x:Key="FeedbackToneBrush" />
    <theme:GeometryKeyConverter x:Key="GeometryKey" />
    <theme:HistoryToneBrushConverter x:Key="HistoryToneBrush" />
    <theme:LogSeverityBrushConverter x:Key="LogSeverityBrush" />
    <theme:HexColorBrushConverter x:Key="HexColorBrush" />

    <!-- Tooltips: the "balão" of the mockup, dark with a soft border; text wraps at 280 px. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Padding="10,8"
                        Background="#1C1C21"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Opacity="0.55" ShadowDepth="4" />
                        </Border.Effect>
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineHeight" Value="17" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons. -->
    <Style x:Key="IbtButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="Background" Value="{StaticResource IbtPanelStrongBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource IbtBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Chrome"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource IbtAccentGlowBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IbtPrimaryButton" BasedOn="{StaticResource IbtButton}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource IbtAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource IbtAccentBrush}" />
        <Setter Property="Foreground" Value="#04130B" />
    </Style>

    <Style x:Key="IbtUrgentButton" BasedOn="{StaticResource IbtButton}" TargetType="Button">
        <Setter Property="Background" Value="#1AFFD87A" />
        <Setter Property="BorderBrush" Value="#73FFD87A" />
        <Setter Property="Foreground" Value="{StaticResource IbtWarnBrush}" />
    </Style>

    <!-- Text field (the "Novo aviso" box). -->
    <Style x:Key="IbtInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource IbtAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource IbtInsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource IbtBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Padding="{TemplateBinding Padding}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#991DA35F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same box for a password: the letters show as dots. -->
    <Style x:Key="IbtPasswordInput" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource IbtAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource IbtInsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource IbtBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border
                        x:Name="Chrome"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            Padding="{TemplateBinding Padding}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Disabled" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#991DA35F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Main window (painel-v7.html: .cd, .tab, .aiopt, .seg, .ib, .lock, .item, details, .saved) ===== -->

    <!-- A small warning under a box: a value that was ignored or held in range. -->
    <Style x:Key="IbtHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource IbtWarnBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,5,0,0" />
    </Style>

    <!-- A side bar tab. Tag is true for the selected tab. -->
    <Style x:Key="IbtTabButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
                <Setter Property="Background" Value="#211DA35F" />
                <Setter Property="BorderBrush" Value="#591DA35F" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The red-tinted button (Encerrar atual, Limpar). -->
    <Style x:Key="IbtDangerButton" BasedOn="{StaticResource IbtButton}" TargetType="Button">
        <Setter Property="Background" Value="#12FF9D9D" />
        <Setter Property="BorderBrush" Value="#59FF9D9D" />
        <Setter Property="Foreground" Value="#FF9D9D" />
    </Style>

    <!-- The origin chip of a row (TELEGRAM / SITE / PC). -->
    <Style x:Key="IbtChip" TargetType="Border">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="BorderBrush" Value="{StaticResource IbtLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="IbtChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
    </Style>

    <!-- The "✓ Salvo" stamp of a tab; it follows the autosave (Saver.State). -->
    <Style x:Key="IbtSavedBadge" TargetType="Border">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="BorderBrush" Value="#4D86E4AD" />
        <Setter Property="Background" Value="#0F86E4AD" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource IbtOkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Saver.State}" Value="Saving">
                <Setter Property="BorderBrush" Value="{StaticResource IbtLineBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource IbtMutedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Saver.State}" Value="Failed">
                <Setter Property="BorderBrush" Value="#59FF5C5C" />
                <Setter Property="Background" Value="#14FF5C5C" />
                <Setter Property="TextElement.Foreground" Value="#FF9D9D" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- An on/off switch (the correction): green with the knob at the right when on. No animation, so it also draws right in a window that was never shown. -->
    <Style x:Key="IbtSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Track"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                        <Ellipse
                            x:Name="Knob"
                            Width="14"
                            Height="14"
                            Margin="3,0"
                            HorizontalAlignment="Left"
                            Fill="{StaticResource IbtTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource IbtAccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource IbtAccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="#04130B" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A folding area (Avançado, Diagnóstico): chevron + header, body hidden until opened. -->
    <Style x:Key="IbtExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton
                            x:Name="HeaderButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{TemplateBinding Foreground}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path
                                    x:Name="Chevron"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource LucideChevronRight}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Style="{StaticResource LucideIcon}"
                                    TextElement.Foreground="{StaticResource IbtMutedBrush}" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
                            </Grid>
                        </ToggleButton>
                        <!-- The body opens and closes smoothly (height + opacity, 180 ms; at once with animations off). -->
                        <theme:RevealHost x:Name="Body" IsOpen="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Margin="0,10,0,0" />
                        </theme:RevealHost>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The (i) that holds the hints. Put the text in ToolTip. -->
    <Style x:Key="IbtInfoIcon" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource IbtMutedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource IbtPanelStrongBrush}" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource IbtTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
