<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views">

    <!--
        The cards of the settings-like tabs (Configuracoes, Som): a titled card (SettingsSection) with one SettingRow per setting.
        Needs AppTheme.xaml, LucideIcons.xaml and Controls.xaml, merged before this file.
    -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The (i) in a section: put the text in ToolTip. -->
        <Style
            x:Key="SectionInfo"
            BasedOn="{StaticResource IbtInfoIcon}"
            TargetType="Border">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>

        <!-- A titled card: the title, then its rows (SettingRow). -->
        <Style x:Key="SettingsSectionStyle" TargetType="local:SettingsSection">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingsSection">
                        <Border Style="{StaticResource IbtCard}">
                            <StackPanel>
                                <TextBlock
                                    x:Name="SectionHeader"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{TemplateBinding Header}" />
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One setting: title (and (i)) on the left, the control on the right, hints under both, a thin line above. -->
        <Style x:Key="SettingRowStyle" TargetType="local:SettingRow">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingRow">
                        <Border
                            MinHeight="46"
                            Padding="0,10"
                            BorderBrush="{StaticResource IbtLineBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel>
                                <local:SplitRowPanel>
                                    <TextBlock
                                        x:Name="RowTitle"
                                        FontSize="12.5"
                                        TextWrapping="Wrap">
                                        <Run Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" /><InlineUIContainer BaselineAlignment="Center">
                                            <Border
                                                x:Name="InfoIcon"
                                                AutomationProperties.Name="Dicas"
                                                Style="{StaticResource SectionInfo}"
                                                ToolTip="{Binding Info, RelativeSource={RelativeSource TemplatedParent}}">
                                                <Path
                                                    Width="15"
                                                    Height="15"
                                                    Data="{StaticResource LucideInfo}"
                                                    Style="{StaticResource LucideIcon}" />
                                            </Border>
                                        </InlineUIContainer></TextBlock>
                                    <ContentPresenter VerticalAlignment="Center" />
                                </local:SplitRowPanel>
                                <ContentPresenter Content="{TemplateBinding Footer}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Info" Value="{x:Null}">
                                <Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
