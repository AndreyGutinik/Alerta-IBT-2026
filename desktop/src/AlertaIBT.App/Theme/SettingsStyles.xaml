<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AlertaIBT.App.Views">

    <!--
        The cards of the settings-like tabs (Configuracoes, Som): a titled card (SettingsSection) with one SettingRow per setting.
        Needs AppTheme.xaml, LucideIcons.xaml and Controls.xaml, merged before this file.
    -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The (i) in a section: put the text in ToolTip. -->
        <Style
            x:Key="SectionInfo"
            BasedOn="{StaticResource IbtInfoIcon}"
            TargetType="Border">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>

        <!-- A titled card: the title, then its rows (SettingRow). -->
        <Style x:Key="SettingsSectionStyle" TargetType="local:SettingsSection">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingsSection">
                        <Border Style="{StaticResource IbtCard}">
                            <StackPanel>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock
                                        x:Name="SectionHeader"
                                        Style="{StaticResource SectionTitle}"
                                        Text="{TemplateBinding Header}" />
                                    <TextBlock
                                        x:Name="SectionSubtitle"
                                        Margin="0,3,0,0"
                                        FontSize="11.5"
                                        Foreground="{StaticResource IbtMutedBrush}"
                                        Text="{TemplateBinding Subtitle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Subtitle" Value="">
                                <Setter TargetName="SectionSubtitle" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One setting: title (and (i)) on the left, the control on the right, hints under both, a thin line above. -->
        <Style x:Key="SettingRowStyle" TargetType="local:SettingRow">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:SettingRow">
                        <Border
                            MinHeight="46"
                            Padding="0,10"
                            BorderBrush="{StaticResource IbtLineBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel>
                                <local:SplitRowPanel>
                                    <TextBlock
                                        x:Name="RowTitle"
                                        FontSize="12.5"
                                        TextWrapping="Wrap">
                                        <Run Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}" /><InlineUIContainer BaselineAlignment="Center">
                                            <Border
                                                x:Name="InfoIcon"
                                                AutomationProperties.Name="Dicas"
                                                Style="{StaticResource SectionInfo}"
                                                ToolTip="{Binding Info, RelativeSource={RelativeSource TemplatedParent}}">
                                                <Path
                                                    Width="15"
                                                    Height="15"
                                                    Data="{StaticResource LucideInfo}"
                                                    Style="{StaticResource LucideIcon}" />
                                            </Border>
                                        </InlineUIContainer></TextBlock>
                                    <ContentPresenter VerticalAlignment="Center" />
                                </local:SplitRowPanel>
                                <ContentPresenter Content="{TemplateBinding Footer}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Info" Value="{x:Null}">
                                <Setter TargetName="InfoIcon" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    <!-- A round toggle chip (the weekdays of an alarm, shuffle): off is quiet, on is the green of the church. -->
    <Style x:Key="IbtToggleChip" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource IbtLineBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Chip"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="#331DA35F" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="#991DA35F" />
                            <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A box for a number or a time in a row: narrow and centered. -->
    <Style
        x:Key="IbtSmallInput"
        BasedOn="{StaticResource IbtInput}"
        TargetType="TextBox">
        <Setter Property="Padding" Value="6,6" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- The items of a list box: quiet, the green wash on the chosen one. -->
    <Style x:Key="IbtComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="Item"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="#1FFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Item" Property="Background" Value="#331DA35F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dark list box like the text boxes (IbtInput): rounded, the chosen text on the left and a chevron on the right. -->
    <Style x:Key="IbtComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource IbtTextBrush}" />
        <Setter Property="Background" Value="#0D0D10" />
        <Setter Property="BorderBrush" Value="{StaticResource IbtLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MarbleFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource IbtComboBoxItem}" />
        <Setter Property="MaxDropDownHeight" Value="246" /> <!-- 8 rows of 29 (+ the frame), then it scrolls -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" />
                        <!--
                            The whole box is the button. It must STRETCH on purpose: the WPF-UI style that reaches this button through the implicit
                            ToggleButton style aligns it to the left, and a template that is only a Border then measures 0 x 0: nothing was there to click.
                        -->
                        <ToggleButton
                            x:Name="DropButton"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter
                            x:Name="ContentSite"
                            Margin="11,0,30,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                            IsHitTestVisible="False">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <Path
                            Width="12"
                            Height="12"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Data="M 6 9 L 12 15 L 18 9"
                            IsHitTestVisible="False"
                            Style="{StaticResource LucideIcon}"
                            TextElement.Foreground="{StaticResource IbtMutedBrush}" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="None">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    Background="#1C1C21"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#991DA35F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            <Setter TargetName="ContentSite" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The timeline of the player (SeekSlider) and the volume slider next to it: a thin rounded track, the played part in the green of the church
        and a round thumb that grows under the mouse. SeekSlider does the clicking and dragging itself; the stock slider logic is not used.
    -->
    <Style x:Key="IbtSeekThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        x:Name="Dot"
                        Width="11"
                        Height="11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource IbtCreamBrush}"
                        CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="6"
                                Opacity="0.55"
                                ShadowDepth="1" />
                        </Border.Effect>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="14" />
                            <Setter TargetName="Dot" Property="Height" Value="14" />
                            <Setter TargetName="Dot" Property="CornerRadius" Value="7" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Width" Value="14" />
                            <Setter TargetName="Dot" Property="Height" Value="14" />
                            <Setter TargetName="Dot" Property="CornerRadius" Value="7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IbtSeekPlayed" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="20" Background="Transparent">
                        <Border
                            Height="4"
                            VerticalAlignment="Center"
                            Background="{StaticResource IbtAccentBrush}"
                            CornerRadius="2,0,0,2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IbtSeekRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="20" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IbtSeekSlider" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border
                            x:Name="Rail"
                            Height="4"
                            VerticalAlignment="Center"
                            Background="#26FFFFFF"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource IbtSeekPlayed}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource IbtSeekRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource IbtSeekThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Rail" Property="BorderBrush" Value="#661DA35F" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
