<Window
    x:Class="AlertaIBT.App.Tray.QuickPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels"
    Title="IBT Controller"
    Width="354"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource MarbleFont}"
    FontSize="13"
    Foreground="{StaticResource IbtTextBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <!--
        The tray panel, in the language of the tabs (Theme/SettingsStyles.xaml): a card lighter than the page with a thin border, one block per thing
        (the state line, what is on the LED, the new alert, the player), icon buttons of 32 px with a tooltip, and only Enviar with a word.
    -->

    <Window.Resources>
        <!-- One of the three status icons: a 32 px square with the Lucide icon and a colored dot in the corner. -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:StatusChip}">
            <Grid
                Width="36"
                Height="36"
                Margin="0,0,4,0"
                AutomationProperties.Name="{Binding Label}"
                ToolTip="{Binding Tip}">
                <Border
                    Width="32"
                    Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource IbtSurfaceRaisedBrush}"
                    BorderBrush="{StaticResource IbtBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    TextElement.Foreground="{StaticResource IbtTextSecondaryBrush}">
                    <Path
                        Width="16"
                        Height="16"
                        Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                        Style="{StaticResource LucideIcon}" />
                </Border>
                <Border
                    Width="12"
                    Height="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{Binding Light, Converter={StaticResource StatusLightBrush}}"
                    BorderBrush="{StaticResource IbtSurfaceBrush}"
                    BorderThickness="2"
                    CornerRadius="6" />
            </Grid>
        </DataTemplate>

        <!-- The music player: a block with previous, play/pause, next and the title of the track (ellipsized). Implicit template: with no content (player off) nothing is built. -->
        <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
            <Border
                Margin="0,12,0,0"
                Padding="10,8"
                Style="{StaticResource IbtBlock}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        AutomationProperties.Name="Música anterior"
                        Command="{Binding PreviousCommand}"
                        Style="{StaticResource IbtToolButton}"
                        ToolTip="Música anterior">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource LucideSkipBack}"
                            Style="{StaticResource LucideIcon}" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        AutomationProperties.Name="{Binding PlayPauseTip}"
                        Command="{Binding PlayPauseCommand}"
                        Style="{StaticResource IbtToolButton}"
                        ToolTip="{Binding PlayPauseTip}">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{Binding PlayPauseIconKey, Converter={StaticResource GeometryKey}}"
                            Style="{StaticResource LucideIcon}" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Próxima música"
                        Command="{Binding NextCommand}"
                        Style="{StaticResource IbtToolButton}"
                        ToolTip="Próxima música">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource LucideSkipForward}"
                            Style="{StaticResource LucideIcon}" />
                    </Button>
                    <TextBlock
                        Grid.Column="3"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{StaticResource IbtTextSecondaryBrush}"
                        Text="{Binding QuickTitle}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding QuickTitle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- The pause button: an icon button that turns yellow while the bar is paused. -->
        <Style
            x:Key="PauseButton"
            BasedOn="{StaticResource IbtToolButton}"
            TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Background" Value="#24FFD87A" />
                    <Setter Property="BorderBrush" Value="#80FFD87A" />
                    <Setter Property="Foreground" Value="{StaticResource IbtWarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="11,10,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=InputBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The 12 px around the card hold its shadow; they also keep the panel off the screen edge. -->
    <Border
        Margin="12"
        Padding="16"
        Background="{StaticResource IbtSurfaceBrush}"
        BorderBrush="{StaticResource IbtBorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.5"
                ShadowDepth="6" />
        </Border.Effect>

        <StackPanel>
            <!-- With the alerts off (the master switch) only the note and the player row stay. -->
            <Grid
                x:Name="AlertsOffNote"
                Visibility="{Binding AlertsOff, Converter={StaticResource BoolToVisibility}}">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Margin="0,0,8,0"
                        Fill="{StaticResource IbtMutedBrush}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource IbtTextSecondaryBrush}"
                        Text="Alertas desligados"
                        ToolTip="Ligue de novo em Configurações, Alertas." />
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="AlertsPart"
                Visibility="{Binding AlertsOn, Converter={StaticResource BoolToVisibility}}">
                <!-- The state line: Telegram, Site and LED with their dots, and the state pill at the right. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{Binding Telegram}" ContentTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                        <ContentControl Content="{Binding Site}" ContentTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                        <ContentControl Content="{Binding Led}" ContentTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="10,5"
                        VerticalAlignment="Center"
                        Background="{StaticResource IbtSurfaceRaisedBrush}"
                        BorderBrush="{StaticResource IbtBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Fill="{Binding PillLight, Converter={StaticResource StatusLightBrush}}" />
                            <TextBlock FontSize="11.5" Text="{Binding PillText}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- On the LED now: the monitor icon (the name is in its tooltip), the source, the text, the time bar and the queue. Empty (no text) when nothing is showing. -->
                <Border
                    Margin="0,12,0,0"
                    Padding="14,12"
                    Style="{StaticResource IbtBlock}">
                    <StackPanel>
                        <Grid MinHeight="22">
                            <Path
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Left"
                                Data="{StaticResource LucideMonitor}"
                                Style="{StaticResource IbtRowIcon}"
                                ToolTip="No telão agora" />
                            <Border
                                HorizontalAlignment="Right"
                                Style="{StaticResource IbtChip}"
                                Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource IbtChipText}" Text="{Binding CurrentSource}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            MinHeight="36"
                            MaxHeight="54"
                            Margin="0,6,0,0"
                            FontSize="13.5"
                            FontWeight="Bold"
                            Foreground="{StaticResource IbtCreamBrush}"
                            LineHeight="18"
                            LineStackingStrategy="BlockLineHeight"
                            Text="{Binding CurrentText}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <Border
                            Height="4"
                            Margin="0,10,0,0"
                            Background="#12FFFFFF"
                            ClipToBounds="True"
                            CornerRadius="2">
                            <Border
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource IbtAccentGlowBrush}"
                                RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding ProgressValue}" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="11.5"
                            Foreground="{StaticResource IbtTextSecondaryBrush}"
                            Text="{Binding QueueSummary}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- The new alert: the message icon with the (i) of the shortcuts, then the box. -->
                <Grid Margin="0,16,0,0" MinHeight="22">
                    <Path
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Left"
                        Data="{StaticResource LucideMessageSquare}"
                        Style="{StaticResource IbtRowIcon}"
                        ToolTip="Novo aviso" />
                    <Border
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Dicas"
                        Style="{StaticResource SectionInfo}"
                        ToolTip="{Binding InfoTip}">
                        <Path
                            Width="15"
                            Height="15"
                            Data="{StaticResource LucideInfo}"
                            Style="{StaticResource LucideIcon}" />
                    </Border>
                </Grid>

                <Grid Margin="0,6,0,0">
                    <TextBox
                        x:Name="InputBox"
                        MaxLines="4"
                        MinLines="2"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Novo aviso"
                        PreviewKeyDown="OnInputKeyDown"
                        Style="{StaticResource IbtInput}"
                        Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Placeholder}" Text="Digite o aviso…" />
                </Grid>

                <!-- Vai aparecer assim: green, blue (offline / aviso livre) or red; plus a yellow line for a repeated plate. -->
                <StackPanel
                    x:Name="PreviewHost"
                    Margin="0,8,0,0"
                    Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ShakeTransform" />
                    </StackPanel.RenderTransform>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewPending}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,1,8,0"
                            VerticalAlignment="Top"
                            Data="{Binding Preview.IconKey, Converter={StaticResource GeometryKey}}"
                            Style="{StaticResource LucideIcon}"
                            TextElement.Foreground="{Binding Preview.Tone, Converter={StaticResource PreviewToneBrush}, ConverterParameter=icon}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="Medium"
                                Foreground="{StaticResource IbtMutedBrush}"
                                Text="{Binding Preview.Label}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="Bold"
                                Foreground="{Binding Preview.Tone, Converter={StaticResource PreviewToneBrush}}"
                                LineHeight="16"
                                Text="{Binding Preview.Text}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,6,0,0" Visibility="{Binding HasPreviewNote, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,1,8,0"
                            VerticalAlignment="Top"
                            Data="{StaticResource LucideTriangleAlert}"
                            Style="{StaticResource LucideIcon}"
                            TextElement.Foreground="{StaticResource IbtWarnBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{StaticResource IbtWarnBrush}"
                            Text="{Binding Preview.Note}"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>

                <!-- What happened to the last send. -->
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="11.5"
                    Foreground="{Binding FeedbackTone, Converter={StaticResource FeedbackToneBrush}}"
                    Text="{Binding FeedbackText}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}" />

                <!-- The global hotkey does not work (another program owns it, or the setting is invalid); the tray click still opens the panel. -->
                <Border
                    Margin="0,10,0,0"
                    Padding="10,8"
                    Background="#14FFD87A"
                    BorderBrush="#40FFD87A"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding HasHotkeyMessage, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path
                            Width="14"
                            Height="14"
                            Margin="0,1,8,0"
                            VerticalAlignment="Top"
                            Data="{StaticResource LucideTriangleAlert}"
                            Style="{StaticResource LucideIcon}"
                            TextElement.Foreground="{StaticResource IbtWarnBrush}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="11"
                            Foreground="{StaticResource IbtWarnBrush}"
                            Text="{Binding HotkeyMessage}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- One line of buttons: only Enviar has a word; the other three are 32 px icons with a tooltip. -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding SendCommand}" Style="{StaticResource IbtPrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Width="15"
                                Height="15"
                                Data="{StaticResource LucideSend}"
                                Style="{StaticResource LucideIcon}" />
                            <TextBlock Margin="6,0,0,0" Text="Enviar" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Width="40"
                        AutomationProperties.Name="Urgente"
                        Command="{Binding SendUrgentCommand}"
                        Style="{StaticResource IbtUrgentButton}"
                        ToolTip="Urgente (fura a fila)">
                        <Path
                            Width="15"
                            Height="15"
                            Data="{StaticResource LucideSiren}"
                            Style="{StaticResource LucideIcon}" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="{Binding PauseTip}"
                        Command="{Binding TogglePauseCommand}"
                        Style="{StaticResource PauseButton}"
                        ToolTip="{Binding PauseTip}">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{Binding PauseIconKey, Converter={StaticResource GeometryKey}}"
                            Style="{StaticResource LucideIcon}" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Abrir janela"
                        Command="{Binding OpenWindowCommand}"
                        Style="{StaticResource IbtToolButton}"
                        ToolTip="Abrir janela completa">
                        <Path
                            Width="16"
                            Height="16"
                            Data="{StaticResource LucideAppWindow}"
                            Style="{StaticResource LucideIcon}" />
                    </Button>
                </Grid>
            </StackPanel>

            <!-- The music player: one compact block, in the tree only while "Player ligado" is on (otherwise nothing is added, not even a margin). -->
            <ContentControl
                Content="{Binding PlayerRow}"
                Focusable="False" />
        </StackPanel>
    </Border>
</Window>
