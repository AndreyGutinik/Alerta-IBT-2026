<Window
    x:Class="AlertaIBT.App.Tray.QuickPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:AlertaIBT.App.ViewModels"
    Title="Alerta-IBT"
    Width="354"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="{StaticResource MarbleFont}"
    FontSize="13"
    Foreground="{StaticResource IbtTextBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <Window.Resources>
        <!-- One of the three status icons: a square with the Lucide icon and a colored dot in the corner. -->
        <DataTemplate x:Key="ChipTemplate" DataType="{x:Type vm:StatusChip}">
            <Grid
                Width="33"
                Height="33"
                Margin="0,0,8,0"
                AutomationProperties.Name="{Binding Label}"
                ToolTip="{Binding Tip}">
                <Border
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{StaticResource IbtPanelStrongBrush}"
                    BorderBrush="{StaticResource IbtLineBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    TextElement.Foreground="#D9D4CA">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{Binding IconKey, Converter={StaticResource GeometryKey}}"
                        Style="{StaticResource LucideIcon}" />
                </Border>
                <Border
                    Width="11"
                    Height="11"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{Binding Light, Converter={StaticResource StatusLightBrush}}"
                    BorderBrush="#141417"
                    BorderThickness="2"
                    CornerRadius="6" />
            </Grid>
        </DataTemplate>

        <!-- The music player row: previous, play/pause, next and the title of the track (ellipsized). Implicit template: with no content (player off) nothing is built. -->
        <DataTemplate DataType="{x:Type vm:PlayerViewModel}">
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.Name="Música anterior"
                    Command="{Binding PreviousCommand}"
                    Style="{StaticResource IbtIconButton}"
                    ToolTip="Música anterior">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{StaticResource LucideSkipForward}"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{StaticResource LucideIcon}">
                        <Path.RenderTransform>
                            <ScaleTransform ScaleX="-1" />
                        </Path.RenderTransform>
                    </Path>
                </Button>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{Binding PlayPauseTip}"
                    Command="{Binding PlayPauseCommand}"
                    Style="{StaticResource IbtIconButton}"
                    ToolTip="{Binding PlayPauseTip}">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{Binding PlayPauseIconKey, Converter={StaticResource GeometryKey}}"
                        Style="{StaticResource LucideIcon}" />
                </Button>
                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Próxima música"
                    Command="{Binding NextCommand}"
                    Style="{StaticResource IbtIconButton}"
                    ToolTip="Próxima música">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{StaticResource LucideSkipForward}"
                        Style="{StaticResource LucideIcon}" />
                </Button>
                <TextBlock
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11.5"
                    Foreground="{StaticResource IbtMutedBrush}"
                    Text="{Binding QuickTitle}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding QuickTitle}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PauseButton" BasedOn="{StaticResource IbtIconButton}" TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                    <Setter Property="Background" Value="#24FFD87A" />
                    <Setter Property="BorderBrush" Value="#80FFD87A" />
                    <Setter Property="Foreground" Value="{StaticResource IbtWarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource IbtMutedBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Margin" Value="11,10,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text.Length, ElementName=InputBox}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The 12 px around the card hold its shadow; they also keep the panel off the screen edge. -->
    <Border
        Margin="12"
        Padding="12"
        Background="#141417"
        BorderBrush="{StaticResource IbtLineBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Opacity="0.5"
                ShadowDepth="6" />
        </Border.Effect>

        <StackPanel>
            <!-- With the alerts off (the master switch) only the note and the player row stay. -->
            <Grid
                x:Name="AlertsOffNote"
                Visibility="{Binding AlertsOff, Converter={StaticResource BoolToVisibility}}">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Border
                        Width="8"
                        Height="8"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{StaticResource IbtMutedBrush}"
                        CornerRadius="4" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource IbtMutedBrush}"
                        Text="Alertas desligados"
                        ToolTip="Ligue de novo em Configurações, Sistema, Alertas." />
                </StackPanel>
            </Grid>

            <StackPanel
                x:Name="AlertsPart"
                Visibility="{Binding AlertsOn, Converter={StaticResource BoolToVisibility}}">
            <!-- Line 1: Telegram, Site and LED with their dots, and the state pill at the right. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{Binding Telegram}" ContentTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Site}" ContentTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                    <ContentControl Content="{Binding Led}" ContentTemplate="{StaticResource ChipTemplate}" Focusable="False" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    Padding="9,4"
                    VerticalAlignment="Center"
                    Background="{StaticResource IbtPanelStrongBrush}"
                    BorderBrush="{StaticResource IbtLineBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="8"
                            Height="8"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Background="{Binding PillLight, Converter={StaticResource StatusLightBrush}}"
                            CornerRadius="4" />
                        <TextBlock FontSize="11.5" Text="{Binding PillText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- No telão agora: empty (no text) when nothing is showing. -->
            <Border
                Margin="0,10,0,0"
                Padding="12"
                Background="{StaticResource IbtPanelBrush}"
                BorderBrush="{StaticResource IbtLineBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <Grid MinHeight="20">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource IbtCaption}"
                            Text="NO TELÃO AGORA" />
                        <Border
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            BorderBrush="{StaticResource IbtLineBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock
                                FontSize="9.5"
                                Foreground="{StaticResource IbtMutedBrush}"
                                Text="{Binding CurrentSource}" />
                        </Border>
                    </Grid>
                    <TextBlock
                        MinHeight="36"
                        MaxHeight="54"
                        Margin="0,2,0,0"
                        FontSize="13.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource IbtCreamBrush}"
                        LineHeight="18"
                        LineStackingStrategy="BlockLineHeight"
                        Text="{Binding CurrentText}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <Border
                        Height="4"
                        Margin="0,10,0,0"
                        Background="#12FFFFFF"
                        ClipToBounds="True"
                        CornerRadius="2">
                        <Border
                            HorizontalAlignment="Stretch"
                            Background="{StaticResource IbtAccentGlowBrush}"
                            RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding ProgressValue}" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock
                        Margin="0,7,0,0"
                        FontSize="11.5"
                        Foreground="{StaticResource IbtMutedBrush}"
                        Text="{Binding QueueSummary}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Novo aviso with the (i) of the shortcuts. -->
            <Grid Margin="0,10,0,0" MinHeight="20">
                <TextBlock
                    HorizontalAlignment="Left"
                    Style="{StaticResource IbtCaption}"
                    Text="NOVO AVISO" />
                <Border
                    HorizontalAlignment="Right"
                    AutomationProperties.Name="Dicas"
                    ToolTipService.InitialShowDelay="150"
                    ToolTipService.ShowDuration="30000"
                    Style="{StaticResource IbtInfoIcon}"
                    ToolTip="{Binding InfoTip}">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{StaticResource LucideInfo}"
                        Style="{StaticResource LucideIcon}" />
                </Border>
            </Grid>

            <Grid Margin="0,4,0,0">
                <TextBox
                    x:Name="InputBox"
                    MaxLines="4"
                    MinLines="2"
                    AcceptsReturn="True"
                    AutomationProperties.Name="Novo aviso"
                    PreviewKeyDown="OnInputKeyDown"
                    Style="{StaticResource IbtInput}"
                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Placeholder}" Text="Digite o aviso…" />
            </Grid>

            <!-- Vai aparecer assim: green, blue (offline / aviso livre) or red; plus a yellow line for a repeated plate. -->
            <StackPanel
                x:Name="PreviewHost"
                Margin="0,7,0,0"
                Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ShakeTransform" />
                </StackPanel.RenderTransform>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewPending}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path
                        Width="13"
                        Height="13"
                        Margin="0,1,6,0"
                        VerticalAlignment="Top"
                        Data="{Binding Preview.IconKey, Converter={StaticResource GeometryKey}}"
                        Style="{StaticResource LucideIcon}"
                        TextElement.Foreground="{Binding Preview.Tone, Converter={StaticResource PreviewToneBrush}, ConverterParameter=icon}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="10.5"
                            FontWeight="Medium"
                            Foreground="{StaticResource IbtMutedBrush}"
                            Text="{Binding Preview.Label}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            FontSize="11.5"
                            FontWeight="Bold"
                            Foreground="{Binding Preview.Tone, Converter={StaticResource PreviewToneBrush}}"
                            LineHeight="16"
                            Text="{Binding Preview.Text}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,5,0,0" Visibility="{Binding HasPreviewNote, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path
                        Width="13"
                        Height="13"
                        Margin="0,1,6,0"
                        VerticalAlignment="Top"
                        Data="{StaticResource LucideTriangleAlert}"
                        Style="{StaticResource LucideIcon}"
                        TextElement.Foreground="{StaticResource IbtWarnBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="11"
                        Foreground="{StaticResource IbtWarnBrush}"
                        Text="{Binding Preview.Note}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>

            <!-- What happened to the last send. -->
            <TextBlock
                Margin="0,6,0,0"
                FontSize="11.5"
                Foreground="{Binding FeedbackTone, Converter={StaticResource FeedbackToneBrush}}"
                Text="{Binding FeedbackText}"
                TextWrapping="Wrap"
                Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}" />

            <!-- The global hotkey does not work (another program owns it, or the setting is invalid); the tray click still opens the panel. -->
            <Border
                Margin="0,8,0,0"
                Padding="8,6"
                Background="#14FFD87A"
                BorderBrush="#40FFD87A"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasHotkeyMessage, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path
                        Width="13"
                        Height="13"
                        Margin="0,1,6,0"
                        VerticalAlignment="Top"
                        Data="{StaticResource LucideTriangleAlert}"
                        Style="{StaticResource LucideIcon}"
                        TextElement.Foreground="{StaticResource IbtWarnBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="11"
                        Foreground="{StaticResource IbtWarnBrush}"
                        Text="{Binding HotkeyMessage}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- One line of buttons: only Enviar has a label. -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding SendCommand}" Style="{StaticResource IbtPrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Width="15"
                            Height="15"
                            Data="{StaticResource LucideSend}"
                            Style="{StaticResource LucideIcon}" />
                        <TextBlock Margin="6,0,0,0" Text="Enviar" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Urgente"
                    Command="{Binding SendUrgentCommand}"
                    Style="{StaticResource IbtUrgentButton}"
                    ToolTip="Urgente (fura a fila)">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{StaticResource LucideSiren}"
                        Style="{StaticResource LucideIcon}" />
                </Button>
                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="{Binding PauseTip}"
                    Command="{Binding TogglePauseCommand}"
                    Style="{StaticResource PauseButton}"
                    ToolTip="{Binding PauseTip}">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{Binding PauseIconKey, Converter={StaticResource GeometryKey}}"
                        Style="{StaticResource LucideIcon}" />
                </Button>
                <Button
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="Abrir janela"
                    Command="{Binding OpenWindowCommand}"
                    Style="{StaticResource IbtIconButton}"
                    ToolTip="Abrir janela completa">
                    <Path
                        Width="15"
                        Height="15"
                        Data="{StaticResource LucideAppWindow}"
                        Style="{StaticResource LucideIcon}" />
                </Button>
            </Grid>

            </StackPanel>

            <!-- The music player: one compact row, in the tree only while "Player ligado" is on (otherwise nothing is added, not even a margin). -->
            <ContentControl
                Content="{Binding PlayerRow}"
                Focusable="False" />
        </StackPanel>
    </Border>
</Window>
